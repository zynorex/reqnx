{
  "name": "demo-api",
  "version": "0.0.0",
  "private": true,
  "description": "REQNX demo API server",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsdown src/index.ts --format esm",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reqnx/core": "workspace:*",
    "@reqnx/express": "workspace:*"
  },
  "devDependencies": {
    "express": "^5.0.0",
    "@types/express": "^5.0.0",
    "typescript": "^5.7.0"
  }
}
