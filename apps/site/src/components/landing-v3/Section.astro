---
// ──────────────────────────────────────────────────────────────────────────────
// apps/site/src/components/landing-v3/Section.astro
//
// Landing v3 Shared Section Primitive:
// - Standardized Section Header Block: Label Chip (28px) -> 16px -> H2 -> 16px -> Lede (56ch) -> 56px -> Content
// - Supports two-tone headings (h2 + h2Muted)
// - Alignment: left or center
// - Below-the-fold content-visibility: auto with contain-intrinsic-size
// ──────────────────────────────────────────────────────────────────────────────

interface Props {
  id?: string;
  label?: string;
  h2?: string;
  h2Muted?: string;
  lede?: string;
  align?: 'left' | 'center';
  sunken?: boolean;
  bleed?: boolean;
  isBelowFold?: boolean;
  containIntrinsicSize?: string;
  class?: string;
}

const {
  id,
  label,
  h2,
  h2Muted,
  lede,
  align = 'left',
  sunken = false,
  bleed = false,
  isBelowFold = false,
  containIntrinsicSize = '1000px',
  class: className = '',
} = Astro.props;
---

<section
  id={id}
  class:list={[
    'rx-v3-section',
    `align-${align}`,
    { 'is-sunken': sunken, 'is-bleed': bleed, 'below-fold': isBelowFold },
    className,
  ]}
  style={isBelowFold ? { '--intrinsic-size': containIntrinsicSize } : undefined}
>
  <div class="rx-v3-section__inner">
    {
      (label || h2 || lede) && (
        <header class="rx-v3-section__header">
          {label && (
            <span class="rx-v3-section__label" aria-hidden="true">
              {label}
            </span>
          )}
          {h2 && (
            <h2 class="rx-v3-section__h2">
              {h2}
              {h2Muted && <span class="rx-v3-section__h2-muted"> {h2Muted}</span>}
            </h2>
          )}
          {lede && <p class="rx-v3-section__lede">{lede}</p>}
        </header>
      )
    }

    <div class="rx-v3-section__content">
      <slot />
    </div>
  </div>
</section>

<style>
  .rx-v3-section {
    width: 100%;
    padding: clamp(72px, 9vw, 112px) 24px;
    background: var(--rx-canvas);
    color: var(--rx-ink);
    position: relative;
    box-sizing: border-box;
  }

  .rx-v3-section.is-sunken {
    background: var(--rx-canvas-sunken);
    border-top: 1px solid var(--rx-hairline);
    border-bottom: 1px solid var(--rx-hairline);
  }

  .rx-v3-section.below-fold {
    content-visibility: auto;
    contain-intrinsic-size: var(--intrinsic-size, 1000px);
  }

  .rx-v3-section__inner {
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
  }

  /* Header Block Geometry */
  .rx-v3-section__header {
    display: flex;
    flex-direction: column;
    margin-bottom: 56px;
  }

  .rx-v3-section.align-center .rx-v3-section__header {
    align-items: center;
    text-align: center;
  }

  .rx-v3-section.align-left .rx-v3-section__header {
    align-items: flex-start;
    text-align: left;
  }

  /* Label Chip: 28px tall, mono uppercase +0.05em, 12/1.3/500 */
  .rx-v3-section__label {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    border-radius: var(--rx-radius-pill, 9999px);
    background: var(--rx-accent-soft);
    color: var(--rx-accent);
    border: 1px solid var(--rx-hairline-strong);
    font-family: var(--rx-font-mono);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 16px;
    user-select: none;
  }

  /* Display L: clamp(32px, 4.4vw, 48px) / 1.05 / 500 / -0.025em */
  .rx-v3-section__h2 {
    font-size: clamp(32px, 4.4vw, 48px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--rx-ink);
    margin: 0 0 16px 0;
    max-width: 24ch;
    text-wrap: balance;
  }

  .rx-v3-section__h2-muted {
    display: block;
    color: var(--rx-muted);
    font-weight: 400;
  }

  /* Lede: 20px / 1.5 (18px on phones), max 56ch */
  .rx-v3-section__lede {
    font-size: 20px;
    line-height: 1.5;
    color: var(--rx-ink-soft);
    max-width: 56ch;
    margin: 0;
    text-wrap: pretty;
  }

  .rx-v3-section__content {
    width: 100%;
  }

  @media (max-width: 768px) {
    .rx-v3-section {
      padding: clamp(48px, 6vw, 72px) 16px;
    }

    .rx-v3-section__header {
      margin-bottom: 36px;
    }

    .rx-v3-section__lede {
      font-size: 18px;
    }
  }
</style>
