---
// ──────────────────────────────────────────────────────────────────────────────
// apps/site/src/components/landing-v3/BenefitsTerminal.astro
//
// Landing v3 Benefits Grid & Sequenced Terminal (S6):
// - Label Chip: ARCHITECTURE
// - H2: Engineered for production resilience.
// - Lede: Designed from day one for mission-critical TypeScript infrastructure.
// - 5 Resilience Benefits (Express/Fastify adapters, single contract, explicit failure, virtual clocks, zero lock-in)
// - Sequenced Vitest Terminal Panel running real core test suites
// ──────────────────────────────────────────────────────────────────────────────

import Section from './Section.astro';
import Button from '../common/Button.astro';

const benefits = [
  {
    num: '01',
    title: 'Fits your existing stack',
    desc: 'First-class adapters for Express, Fastify, and standalone TypeScript services with zero boilerplate.',
    badge: 'Framework Agnostic',
  },
  {
    num: '02',
    title: 'Single unified contract',
    desc: 'Swap seamlessly between in-memory LRU and distributed Redis stores without altering any business logic.',
    badge: 'Store Decoupled',
  },
  {
    num: '03',
    title: 'Explicit failure modes',
    desc: 'Choose between fail-open, fail-closed, or route to custom degradation policies if backing infrastructure fails.',
    badge: 'Never Hangs',
  },
  {
    num: '04',
    title: 'Testable by design',
    desc: 'Injected monotonic clocks allow verifying 30-day rate windows in sub-millisecond deterministic unit tests.',
    badge: 'Virtual Clocks',
  },
  {
    num: '05',
    title: 'Zero lock-in & zero telemetry',
    desc: 'Permissive MIT license, clean typed source code, and zero hidden analytics or network telemetry.',
    badge: 'MIT Open Source',
  },
];

const terminalLines = [
  { type: 'command', text: '$ pnpm --filter @reqnx/core test' },
  { type: 'meta', text: ' RUN  v2.1.8 D:/zynorex/reqnx/packages/core' },
  { type: 'blank', text: '' },
  { type: 'pass', text: ' ✓ src/__tests__/duration.test.ts (6 tests) 12ms' },
  { type: 'pass', text: ' ✓ src/__tests__/errors.test.ts (8 tests) 9ms' },
  { type: 'pass', text: ' ✓ src/__tests__/keys.test.ts (11 tests) 16ms' },
  { type: 'pass', text: ' ✓ src/__tests__/fixed-window.test.ts (24 tests) 28ms' },
  { type: 'pass', text: ' ✓ src/__tests__/memory-store.test.ts (19 tests) 31ms' },
  { type: 'pass', text: ' ✓ src/__tests__/token-bucket.test.ts (31 tests) 38ms' },
  { type: 'pass', text: ' ✓ src/__tests__/token-bucket.properties.test.ts (100 runs) 84ms' },
  { type: 'pass', text: ' ✓ src/__tests__/token-bucket.model.test.ts (100 runs) 76ms' },
  { type: 'pass', text: ' ✓ src/__tests__/limiter.test.ts (27 tests) 34ms' },
  { type: 'blank', text: '' },
  { type: 'summary-files', text: ' Test Files  9 passed (9)' },
  { type: 'summary-tests', text: '      Tests  143 passed (143)' },
  { type: 'summary-time', text: '   Duration  328ms (tests 328ms)' },
];
---

<Section
  id="resilience"
  label="ARCHITECTURE"
  h2="Engineered for production resilience."
  lede="Designed from day one for mission-critical TypeScript infrastructure."
  align="left"
  sunken={true}
  class="rx-benefits-section"
  isBelowFold={true}
>
  <div class="rx-benefits-grid">
    <!-- Left Column: 5 Resilience Rows -->
    <div class="rx-benefits-list">
      {
        benefits.map((b) => (
          <div class="rx-benefit-card">
            <div class="rx-benefit-num-col">
              <span class="rx-benefit-num" aria-hidden="true">{b.num}</span>
            </div>
            <div class="rx-benefit-body">
              <div class="rx-benefit-header">
                <h3 class="rx-benefit-title">{b.title}</h3>
                <span class="rx-benefit-badge">{b.badge}</span>
              </div>
              <p class="rx-benefit-desc">{b.desc}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Right Column: Sequenced Vitest Terminal -->
    <div class="rx-terminal-column">
      <div class="rx-terminal-frame" id="rx-terminal-frame">
        <!-- Terminal Titlebar -->
        <div class="rx-terminal-titlebar">
          <div class="rx-terminal-dots" aria-hidden="true">
            <span class="rx-dot rx-dot--red"></span>
            <span class="rx-dot rx-dot--yellow"></span>
            <span class="rx-dot rx-dot--green"></span>
          </div>
          <span class="rx-terminal-title">pnpm --filter @reqnx/core test</span>
          <div class="rx-terminal-actions">
            <Button
              id="rx-terminal-replay-btn"
              variant="tertiary"
              size="sm"
              shape="pill"
              ariaLabel="Replay test execution animation"
              className="rx-terminal-btn"
            >
              <span class="rx-replay-icon" aria-hidden="true">&#x21bb;</span>
              <span>Replay</span>
            </Button>
          </div>
        </div>

        <!-- Terminal Output -->
        <div class="rx-terminal-body" tabindex="0" role="region" aria-label="Vitest test runner execution output">
          <pre class="rx-terminal-pre"><code id="rx-terminal-code">{
            terminalLines.map((line, idx) => (
              <div
                class:list={[
                  'rx-terminal-line',
                  `rx-line--${line.type}`,
                  { 'is-revealed': true }
                ]}
                data-line-idx={idx}
              >
                {line.text}
              </div>
            ))
          }</code></pre>
        </div>

        <!-- Terminal Status Footer -->
        <div class="rx-terminal-footer">
          <span class="rx-terminal-status-dot" aria-hidden="true"></span>
          <span class="rx-terminal-status-text">All 9 test suites passing (328ms)</span>
          <span class="rx-terminal-coverage">100% Core Contract Coverage</span>
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .rx-benefits-section {
    position: relative;
    width: 100%;
  }

  .rx-benefits-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
    width: 100%;
  }

  /* Left Column: Benefit List */
  .rx-benefits-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .rx-benefit-card {
    display: flex;
    gap: 20px;
    padding: 20px 24px;
    background: var(--rx-canvas);
    border: 1px solid var(--rx-hairline);
    border-radius: var(--rx-radius-md, 8px);
    transition:
      border-color var(--rx-dur-fast) var(--rx-ease-out),
      transform var(--rx-dur-fast) var(--rx-ease-out);
  }

  .rx-benefit-card:hover {
    border-color: var(--rx-hairline-strong);
    transform: translateX(2px);
  }

  .rx-benefit-num-col {
    display: flex;
    align-items: flex-start;
  }

  .rx-benefit-num {
    font-family: var(--rx-font-mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--rx-accent);
    padding-top: 2px;
  }

  .rx-benefit-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .rx-benefit-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .rx-benefit-title {
    font-family: var(--rx-font-sans);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--rx-ink);
    margin: 0;
  }

  .rx-benefit-badge {
    font-family: var(--rx-font-mono);
    font-size: 11px;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: var(--rx-radius-pill, 9999px);
    background: var(--rx-canvas-sunken);
    border: 1px solid var(--rx-hairline);
    color: var(--rx-ink-soft);
    letter-spacing: 0.02em;
  }

  .rx-benefit-desc {
    font-family: var(--rx-font-sans);
    font-size: 14px;
    line-height: 1.5;
    color: var(--rx-ink-soft);
    margin: 0;
  }

  /* Right Column: Terminal Panel */
  .rx-terminal-column {
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 96px;
  }

  .rx-terminal-frame {
    display: flex;
    flex-direction: column;
    background: #0d1117;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--rx-radius-md, 8px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.25);
    overflow: hidden;
    color: #e6edf3;
  }

  .rx-terminal-titlebar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    background: #161b22;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .rx-terminal-dots {
    display: flex;
    gap: 6px;
  }

  .rx-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .rx-dot--red { background: #ff5f56; }
  .rx-dot--yellow { background: #ffbd2e; }
  .rx-dot--green { background: #27c93f; }

  .rx-terminal-title {
    font-family: var(--rx-font-mono);
    font-size: 12px;
    font-weight: 500;
    color: #8b949e;
  }

  .rx-replay-icon {
    font-size: 14px;
    margin-right: 4px;
  }

  :global(.rx-terminal-btn.btn) {
    color: #e6edf3 !important;
    background: rgba(255, 255, 255, 0.06) !important;
    border-color: rgba(255, 255, 255, 0.16) !important;
  }

  :global(.rx-terminal-btn.btn:hover) {
    color: #ffffff !important;
    background: rgba(255, 255, 255, 0.12) !important;
    border-color: rgba(255, 255, 255, 0.28) !important;
  }

  .rx-terminal-body {
    padding: 20px;
    min-height: 380px;
    overflow-x: auto;
    background: #090d13;
  }

  .rx-terminal-body:focus-visible {
    outline: 2px solid var(--rx-accent);
    outline-offset: -2px;
  }

  .rx-terminal-pre {
    margin: 0;
    font-family: var(--rx-font-mono);
    font-size: 12.5px;
    line-height: 1.6;
  }

  .rx-terminal-line {
    white-space: pre-wrap;
    transition: opacity 120ms ease-out;
  }

  .rx-terminal-line.is-hidden {
    display: none;
  }

  .rx-line--command {
    color: #58a6ff;
    font-weight: 600;
  }

  .rx-line--meta {
    color: #8b949e;
  }

  .rx-line--pass {
    color: #3fb950;
  }

  .rx-line--summary-files {
    color: #3fb950;
    font-weight: 600;
  }

  .rx-line--summary-tests {
    color: #3fb950;
    font-weight: 600;
  }

  .rx-line--summary-time {
    color: #8b949e;
  }

  .rx-terminal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: #161b22;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--rx-font-mono);
    font-size: 11px;
    color: #8b949e;
  }

  .rx-terminal-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3fb950;
    margin-right: 6px;
    display: inline-block;
  }

  .rx-terminal-coverage {
    color: #58a6ff;
  }

  @media (max-width: 1024px) {
    .rx-benefits-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .rx-terminal-column {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .rx-terminal-body {
      min-height: auto;
      padding: 14px;
    }

    .rx-terminal-pre {
      font-size: 11px;
    }
  }
</style>

<script>
  function setupTerminalReplay() {
    const replayBtn = document.getElementById('rx-terminal-replay-btn');
    const lines = document.querySelectorAll<HTMLElement>('.rx-terminal-line');
    if (!replayBtn || lines.length === 0) return;

    let timer: number | null = null;

    function playSequence() {
      if (timer) clearInterval(timer);

      // Check reduced motion preference
      const isReduced = document.documentElement.dataset.motion === 'reduced' ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (isReduced) {
        lines.forEach((l) => l.classList.remove('is-hidden'));
        return;
      }

      // Hide all lines first
      lines.forEach((l) => l.classList.add('is-hidden'));

      let currentIdx = 0;
      timer = window.setInterval(() => {
        if (currentIdx >= lines.length) {
          if (timer) clearInterval(timer);
          return;
        }

        const line = lines[currentIdx];
        if (line) {
          line.classList.remove('is-hidden');
        }
        currentIdx++;
      }, 70);
    }

    replayBtn.addEventListener('click', () => {
      playSequence();
    });
  }

  setupTerminalReplay();
  document.addEventListener('astro:page-load', setupTerminalReplay);
</script>
