---
import Section from './Section.astro';
import { features } from '../../features';
import { landingCopy } from '../../copy/landing.copy';
import StatusChip from '../common/StatusChip.astro';
import Icon from '../common/Icon.astro';

const { status: statusCopy } = landingCopy;

const availableCount = features.filter((f) => f.status === 'available').length;
const totalCount = features.length;
const percent = Math.round((availableCount / totalCount) * 100);

const kinds = [
  { key: 'algorithm', label: 'Algorithms' },
  { key: 'store', label: 'Stores' },
  { key: 'primitive', label: 'Core Primitives' },
  { key: 'adapter', label: 'Framework Adapters' },
] as const;
---

<Section
  id="status"
  eyebrow={statusCopy.eyebrow}
  title={statusCopy.title}
  lede={statusCopy.lede}
  alt={true}
>
  <!-- Progress Overview -->
  <div class="rx-status-overview">
    <div class="rx-status-metric-box">
      <span class="rx-status-number">{availableCount} of {totalCount}</span>
      <span class="rx-status-label">Capabilities Implemented & Verified</span>
    </div>

    <!-- Progress bar -->
    <div class="rx-progress-bar-wrap" role="progressbar" aria-label="Implementation progress" aria-valuenow={percent} aria-valuemin={0} aria-valuemax={100}>
      <div class="rx-progress-fill" style={`width: ${percent}%;`}></div>
    </div>
    <span class="rx-progress-text">{percent}% feature complete</span>
  </div>

  <!-- Feature Grid by Kind -->
  <div class="rx-kinds-grid">
    {kinds.map((k) => {
      const items = features.filter((f) => f.kind === k.key);
      return (
        <div class="rx-kind-col">
          <h3 class="rx-kind-title">{k.label}</h3>
          <div class="rx-feature-cards">
            {items.map((item) => (
              <div class="rx-feature-card">
                <div class="rx-feature-top">
                  <span class="rx-feature-name">{item.name}</span>
                  <StatusChip status={item.status} size="sm" />
                </div>
                <p class="rx-feature-blurb">{item.blurb}</p>
                {'evidencePath' in item && item.evidencePath && (
                  <a
                    href={`https://github.com/zynorex/reqnx/blob/main/${item.evidencePath}`}
                    class="rx-feature-link"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span>Evidence: <code>{item.evidencePath}</code></span>
                    <Icon name="external" size={11} ariaHidden={true} />
                  </a>
                )}
              </div>
            ))}
          </div>
        </div>
      );
    })}
  </div>

  <!-- Not Yet Verified Section -->
  <div class="rx-unverified-box">
    <div class="rx-unverified-header">
      <div class="rx-unverified-badge">
        <Icon name="diamond" size={14} ariaHidden={true} />
        <span>Strict Honesty</span>
      </div>
      <h3 class="rx-unverified-title">{statusCopy.notYetVerifiedTitle}</h3>
    </div>
    <ul class="rx-unverified-list">
      {statusCopy.notYetVerifiedPoints.map((point) => (
        <li class="rx-unverified-item">
          <span class="rx-unverified-dot" aria-hidden="true">•</span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  /* Progress Overview */
  .rx-status-overview {
    background: var(--rx-surface-1);
    border: 1px solid var(--rx-border);
    border-radius: var(--rx-radius-md);
    padding: clamp(1.25rem, 3vw, 2rem);
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .rx-status-metric-box {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .rx-status-number {
    font-family: var(--rx-font-mono);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--rx-accent-cyan);
    line-height: 1;
  }

  .rx-status-label {
    font-family: var(--rx-font-mono);
    font-size: 0.875rem;
    color: var(--rx-text-1);
    font-weight: 600;
  }

  .rx-progress-bar-wrap {
    width: 100%;
    height: 8px;
    background: var(--rx-surface-3);
    border-radius: var(--rx-radius-full);
    overflow: hidden;
    position: relative;
  }

  .rx-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--rx-accent-cyan) 0%, var(--rx-accent-indigo) 100%);
    border-radius: var(--rx-radius-full);
    transition: width var(--rx-transition-slow);
  }

  .rx-progress-text {
    font-family: var(--rx-font-mono);
    font-size: 0.75rem;
    color: var(--rx-text-3);
  }

  /* Grid by kind */
  .rx-kinds-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .rx-kind-title {
    font-size: 1rem;
    color: var(--rx-text-1);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rx-border-subtle);
  }

  .rx-feature-cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .rx-feature-card {
    background: var(--rx-surface-1);
    border: 1px solid var(--rx-border-subtle);
    border-radius: var(--rx-radius-sm);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .rx-feature-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .rx-feature-name {
    font-family: var(--rx-font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--rx-text-1);
  }

  .rx-feature-blurb {
    font-size: 0.75rem;
    color: var(--rx-text-2);
    margin: 0;
    line-height: 1.45;
  }

  .rx-feature-link {
    margin-top: 0.25rem;
    font-family: var(--rx-font-mono);
    font-size: 0.6875rem;
    color: var(--rx-text-3);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    word-break: break-all;
  }

  .rx-feature-link code {
    color: var(--rx-accent-cyan);
  }

  .rx-feature-link:hover {
    color: var(--rx-accent-cyan);
  }

  /* Unverified Box */
  .rx-unverified-box {
    background: var(--rx-surface-1);
    border: 1px solid var(--rx-border-subtle);
    border-radius: var(--rx-radius-md);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .rx-unverified-header {
    margin-bottom: 1rem;
  }

  .rx-unverified-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--rx-font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--rx-brand-gold);
    margin-bottom: 0.375rem;
  }

  .rx-unverified-title {
    font-size: 1.0625rem;
    color: var(--rx-text-1);
    margin: 0;
  }

  .rx-unverified-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .rx-unverified-item {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    font-size: 0.8125rem;
    color: var(--rx-text-2);
    line-height: 1.5;
  }

  .rx-unverified-dot {
    color: var(--rx-brand-gold);
    font-weight: bold;
  }
</style>
