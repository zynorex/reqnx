---
import Section from './Section.astro';
import { landingCopy } from '../../copy/landing.copy';
import { siteConfig, withBase } from '../../site.config';
import CopyButton from '../common/CopyButton';
import Icon from '../common/Icon.astro';
import Mascot from '../brand/Mascot.astro';

const { ctaBand } = landingCopy;
const commandText = siteConfig.published ? siteConfig.installCmd : siteConfig.fromSourceCmd;
const commandLabel = siteConfig.published ? 'Install' : 'Run from source';
---

<Section id="final-cta" title="" contentVisibility={false}>
  <div class="rx-final-cta-card rx-window-tick-bg">
    <div class="rx-final-content">
      <div class="rx-final-mascot" aria-hidden="true">
        <Mascot placement="cta" />
      </div>

      <div class="rx-final-body">
        <h2 class="rx-final-title">{ctaBand.title}</h2>
        <p class="rx-final-lede">{ctaBand.lede}</p>

        <div class="rx-final-actions">
          <a href={withBase('/getting-started/')} class="rx-btn rx-btn--primary">
            <span>{ctaBand.primary}</span>
            <Icon name="arrow-right" size={16} ariaHidden={true} />
          </a>
          <a href={withBase('/playground/')} class="rx-btn rx-btn--secondary">
            <span>{ctaBand.secondary}</span>
          </a>
          <a href={siteConfig.repo} class="rx-btn rx-btn--ghost" target="_blank" rel="noopener noreferrer">
            <Icon name="github" size={16} ariaHidden={true} />
            <span>GitHub</span>
          </a>
        </div>

        <div class="rx-cmd-box rx-final-cmd">
          <span class="rx-cmd-box__label">{commandLabel}</span>
          <code class="rx-cmd-box__code" tabindex="0" role="region" aria-label="Terminal command">{commandText}</code>
          <CopyButton client:load text={commandText} />
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .rx-final-cta-card {
    background: var(--rx-surface-2);
    border: 1px solid var(--rx-border);
    border-radius: var(--rx-radius-lg);
    padding: clamp(2rem, 5vw, 4rem);
    position: relative;
    overflow: hidden;
  }

  .rx-final-content {
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  @media (max-width: 900px) {
    .rx-final-content {
      flex-direction: column;
      text-align: center;
      gap: 2rem;
    }
  }

  .rx-final-mascot {
    flex-shrink: 0;
  }

  .rx-final-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .rx-final-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin: 0;
    color: var(--rx-text-1);
    line-height: 1.15;
  }

  .rx-final-lede {
    font-size: 1rem;
    color: var(--rx-text-2);
    margin: 0;
    line-height: 1.6;
    max-width: 55ch;
  }

  .rx-final-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  @media (max-width: 900px) {
    .rx-final-actions {
      justify-content: center;
    }
  }

  .rx-final-cmd {
    margin-top: 0.5rem;
    max-width: 480px;
  }

  @media (max-width: 900px) {
    .rx-final-cmd {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
