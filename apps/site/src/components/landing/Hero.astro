---
import { siteConfig, withBase } from '../../site.config';
import { landingCopy } from '../../copy/landing.copy';
import { getPrecomputedHeroState } from '../../engine/hero-precompute';
import { LiveConsole } from './LiveConsole';
import ProofStrip from './ProofStrip.astro';
import CopyButton from '../common/CopyButton';
import Icon from '../common/Icon.astro';
import Mascot from '../brand/Mascot.astro';

const initialState = await getPrecomputedHeroState();
const commandText = siteConfig.published ? siteConfig.installCmd : siteConfig.fromSourceCmd;
const commandLabel = siteConfig.published ? 'Install' : 'Run from source';
---

<section class="rx-hero-section" id="hero">
  <!-- E5: Grid Scan Band Sweep -->
  <div class="rx-hero-scan-band" aria-hidden="true"></div>

  <!-- E6: Grid Pointer Backlight -->
  <div class="rx-grid-backlight" aria-hidden="true" id="rx-hero-backlight"></div>

  <div class="rx-hero-container">
    <!-- Eyebrow Chip -->
    <div class="rx-eyebrow-chip">
      <span class="rx-eyebrow-chip__dot" aria-hidden="true"></span>
      <span>{landingCopy.hero.eyebrow}</span>
    </div>

    <!-- Main Headline (LCP element, server-rendered, no animation delay) -->
    <h1 class="rx-hero-title">
      {landingCopy.hero.headline.includes('checkable') ? (
        <>
          Rate limiting built from small, <span class="rx-hero-title__accent">checkable</span> parts.
        </>
      ) : (
        landingCopy.hero.headline
      )}
    </h1>

    <!-- Subhead Prose -->
    <p class="rx-hero-subhead">
      {landingCopy.hero.subhead}
    </p>

    <!-- CTAs and Command Line -->
    <div class="rx-hero-actions">
      <div class="rx-hero-ctas">
        <a href={withBase('/getting-started/')} class="rx-btn rx-btn--primary">
          <span>{landingCopy.hero.ctaPrimary}</span>
          <Icon name="arrow-right" size={16} ariaHidden={true} />
        </a>
        <a href={withBase('/playground/')} class="rx-btn rx-btn--secondary">
          <span>{landingCopy.hero.ctaSecondary}</span>
        </a>
      </div>

      <div class="rx-cmd-box">
        <span class="rx-cmd-box__label">{commandLabel}</span>
        <code class="rx-cmd-box__code" tabindex="0" role="region" aria-label="Terminal command">{commandText}</code>
        <CopyButton client:load text={commandText} />
      </div>
    </div>

    <!-- The Instrument: Live Browser Console with Mascot Co-Pilot -->
    <div class="rx-hero-console-stage">
      <div class="rx-hero-mascot-wrapper" id="rx-hero-mascot-wrapper" aria-hidden="true">
        <Mascot placement="hero" />
      </div>
      <LiveConsole client:idle initialState={initialState} />
    </div>

    <!-- Verified Facts Proof Strip -->
    <ProofStrip />
  </div>
</section>

<script>
  import { trackPointer } from '../../motion/pointer.js';

  // E6: Grid Backlight pointer tracking
  const heroSection = document.getElementById('hero');
  if (heroSection) {
    trackPointer(heroSection, (x, y) => {
      heroSection.style.setProperty('--pointer-x', `${x}px`);
      heroSection.style.setProperty('--pointer-y', `${y}px`);
    });
  }

  // E22: Mascot reaction to console denials
  const mascotWrapper = document.getElementById('rx-hero-mascot-wrapper');
  if (mascotWrapper) {
    window.addEventListener('rx-console-denial', () => {
      mascotWrapper.classList.remove('is-nodding');
      // trigger reflow
      void mascotWrapper.offsetWidth;
      mascotWrapper.classList.add('is-nodding');
      setTimeout(() => mascotWrapper.classList.remove('is-nodding'), 220);
    });
  }
</script>
