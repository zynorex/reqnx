---
import Section from './Section.astro';
import { landingCopy } from '../../copy/landing.copy';
import CopyButton from '../common/CopyButton';
import Icon from '../common/Icon.astro';
import quickstartOutput from '../../snippets/quickstart.output.json';

const { quickstart } = landingCopy;

const coreCode = `import { createLimiter, createMemoryStore, fixedWindow } from '@reqnx/core';

// 1. Initialise store (supports injected Clock for deterministic testing)
const store = createMemoryStore();

// 2. Configure rate limiter instance
const limiter = createLimiter({
  algorithm: fixedWindow,
  store,
  prefix: 'api',
  config: {
    limit: 5,
    window: '10s',
  },
});

// 3. Evaluate caller quota
const decision = await limiter.check('user:1042');

if (!decision.allowed) {
  // Reject caller: retryAfterMs indicates wait time
  throw new Error(\`Rate limit exceeded. Retry in \${decision.retryAfterMs}ms\`);
}`;

const expressCode = `// Planned for Day 7: @reqnx/express
import express from 'express';
import { createLimiter, createMemoryStore, fixedWindow } from '@reqnx/core';
import { reqnxMiddleware } from '@reqnx/express';

const app = express();
const store = createMemoryStore();

const limiter = createLimiter({
  algorithm: fixedWindow,
  store,
  config: { limit: 100, window: '1m' },
});

app.use(reqnxMiddleware({
  limiter,
  keyResolver: (req) => req.ip ?? 'unknown',
}));`;

const fastifyCode = `// Planned for Day 7: @reqnx/fastify
import Fastify from 'fastify';
import { createLimiter, createMemoryStore, fixedWindow } from '@reqnx/core';
import { reqnxPlugin } from '@reqnx/fastify';

const fastify = Fastify();
const store = createMemoryStore();

const limiter = createLimiter({
  algorithm: fixedWindow,
  store,
  config: { limit: 100, window: '1m' },
});

await fastify.register(reqnxPlugin, {
  limiter,
  keyResolver: (req) => req.headers['x-api-key'] ?? req.ip,
});`;

const redisCode = `// Planned for Day 6: @reqnx/redis
import { Redis } from 'ioredis';
import { createLimiter, fixedWindow } from '@reqnx/core';
import { createRedisStore } from '@reqnx/redis';

const redis = new Redis(process.env.REDIS_URL);
const store = createRedisStore({ client: redis });

const limiter = createLimiter({
  algorithm: fixedWindow,
  store,
  prefix: 'tenant',
  config: { limit: 50, window: '1m' },
});`;
---

<Section
  id="quickstart"
  eyebrow={quickstart.eyebrow}
  title={quickstart.title}
  lede={quickstart.lede}
>
  <div class="rx-quickstart-grid">
    <!-- Left Column: Code Tabs -->
    <div class="rx-code-column" data-quickstart-tabs>
      <div class="rx-code-tabs-header" role="tablist" aria-label="Quickstart code variants">
        <button
          type="button"
          role="tab"
          id="qs-tab-core"
          aria-selected="true"
          aria-controls="qs-panel-core"
          tabindex="0"
          class="rx-qs-tab-btn is-active"
          data-qs-tab="core"
        >
          @reqnx/core
        </button>
        <button
          type="button"
          role="tab"
          id="qs-tab-express"
          aria-selected="false"
          aria-controls="qs-panel-express"
          tabindex="-1"
          class="rx-qs-tab-btn"
          data-qs-tab="express"
        >
          Express (Planned)
        </button>
        <button
          type="button"
          role="tab"
          id="qs-tab-fastify"
          aria-selected="false"
          aria-controls="qs-panel-fastify"
          tabindex="-1"
          class="rx-qs-tab-btn"
          data-qs-tab="fastify"
        >
          Fastify (Planned)
        </button>
        <button
          type="button"
          role="tab"
          id="qs-tab-redis"
          aria-selected="false"
          aria-controls="qs-panel-redis"
          tabindex="-1"
          class="rx-qs-tab-btn"
          data-qs-tab="redis"
        >
          Redis (Planned)
        </button>
      </div>

      <!-- Core Code Panel -->
      <div id="qs-panel-core" role="tabpanel" aria-labelledby="qs-tab-core" class="rx-qs-panel is-active" data-qs-panel="core">
        <div class="rx-code-card">
          <div class="rx-code-toolbar">
            <span class="rx-code-filename">quickstart.ts</span>
            <CopyButton client:load text={coreCode} />
          </div>
          <pre class="rx-code-block"><code>{coreCode}</code></pre>
        </div>
      </div>

      <!-- Express Code Panel -->
      <div id="qs-panel-express" role="tabpanel" aria-labelledby="qs-tab-express" class="rx-qs-panel" data-qs-panel="express">
        <div class="rx-code-card">
          <div class="rx-code-toolbar">
            <span class="rx-code-filename">express-server.ts</span>
            <CopyButton client:load text={expressCode} />
          </div>
          <pre class="rx-code-block"><code>{expressCode}</code></pre>
        </div>
      </div>

      <!-- Fastify Code Panel -->
      <div id="qs-panel-fastify" role="tabpanel" aria-labelledby="qs-tab-fastify" class="rx-qs-panel" data-qs-panel="fastify">
        <div class="rx-code-card">
          <div class="rx-code-toolbar">
            <span class="rx-code-filename">fastify-server.ts</span>
            <CopyButton client:load text={fastifyCode} />
          </div>
          <pre class="rx-code-block"><code>{fastifyCode}</code></pre>
        </div>
      </div>

      <!-- Redis Code Panel -->
      <div id="qs-panel-redis" role="tabpanel" aria-labelledby="qs-tab-redis" class="rx-qs-panel" data-qs-panel="redis">
        <div class="rx-code-card">
          <div class="rx-code-toolbar">
            <span class="rx-code-filename">redis-limiter.ts</span>
            <CopyButton client:load text={redisCode} />
          </div>
          <pre class="rx-code-block"><code>{redisCode}</code></pre>
        </div>
      </div>
    </div>

    <!-- Right Column: Verified Output Fixture -->
    <div class="rx-output-column">
      <div class="rx-output-card">
        <div class="rx-output-header">
          <div class="rx-output-badge">
            <span class="rx-badge-dot"></span>
            <span>{quickstart.outputTitle}</span>
          </div>
          <span class="rx-output-caption">{quickstart.outputCaption}</span>
        </div>

        <div class="rx-output-table-wrap">
          <table class="rx-output-table">
            <thead>
              <tr>
                <th>Req</th>
                <th>Allowed</th>
                <th>Remaining</th>
                <th>Retry After</th>
              </tr>
            </thead>
            <tbody>
              {quickstartOutput.map((row) => (
                <tr class={row.allowed ? 'is-allowed' : 'is-denied'}>
                  <td>#{row.request}</td>
                  <td>
                    <span class={`rx-decision-chip ${row.allowed ? 'allowed' : 'denied'}`}>
                      {row.allowed ? 'ALLOWED' : 'DENIED'}
                    </span>
                  </td>
                  <td>{row.remaining} / {row.limit}</td>
                  <td>{row.retryAfterMs > 0 ? `${row.retryAfterMs}ms` : '0ms'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="rx-output-footer">
          <p class="rx-output-summary">
            Requests 1–5 admitted within 10s window. Requests 6 and 7 rejected with 9000ms retry-after.
          </p>
        </div>
      </div>
    </div>
  </div>
</Section>

<script>
  function setupQsTabs() {
    const container = document.querySelector('[data-quickstart-tabs]');
    if (!container) return;

    const tabs = Array.from(container.querySelectorAll<HTMLButtonElement>('[data-qs-tab]'));
    const panels = Array.from(container.querySelectorAll<HTMLElement>('[data-qs-panel]'));

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-qs-tab');

        tabs.forEach((t) => {
          const isSelected = t === tab;
          t.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          t.tabIndex = isSelected ? 0 : -1;
          t.classList.toggle('is-active', isSelected);
        });

        panels.forEach((p) => {
          const match = p.getAttribute('data-qs-panel') === target;
          p.classList.toggle('is-active', match);
        });
      });
    });
  }

  setupQsTabs();
  document.addEventListener('astro:page-load', setupQsTabs);
</script>

<style>
  .rx-quickstart-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (max-width: 960px) {
    .rx-quickstart-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Code Column */
  .rx-code-tabs-header {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .rx-qs-tab-btn {
    padding: 0.5rem 0.875rem;
    font-family: var(--rx-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--rx-text-3);
    background: var(--rx-surface-2);
    border: 1px solid var(--rx-border);
    border-radius: var(--rx-radius-sm);
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--rx-transition-fast);
  }

  .rx-qs-tab-btn:hover {
    color: var(--rx-text-1);
    background: var(--rx-surface-3);
  }

  .rx-qs-tab-btn.is-active {
    color: var(--rx-accent-cyan);
    border-color: var(--rx-accent-cyan);
    background: var(--rx-surface-3);
  }

  .rx-qs-panel {
    display: none;
  }

  .rx-qs-panel.is-active {
    display: block;
  }

  .rx-code-card {
    background: var(--rx-surface-2);
    border: 1px solid var(--rx-border);
    border-radius: var(--rx-radius-md);
    overflow: hidden;
  }

  .rx-code-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 1rem;
    background: var(--rx-surface-3);
    border-bottom: 1px solid var(--rx-border);
  }

  .rx-code-filename {
    font-family: var(--rx-font-mono);
    font-size: 0.75rem;
    color: var(--rx-text-3);
  }

  .rx-code-block {
    margin: 0;
    padding: 1.25rem;
    font-family: var(--rx-font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    overflow-x: auto;
    color: var(--rx-text-2);
  }

  /* Output Column */
  .rx-output-card {
    background: var(--rx-surface-2);
    border: 1px solid var(--rx-border);
    border-radius: var(--rx-radius-md);
    overflow: hidden;
  }

  .rx-output-header {
    padding: 0.75rem 1rem;
    background: var(--rx-surface-3);
    border-bottom: 1px solid var(--rx-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .rx-output-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--rx-font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--rx-semantic-allowed);
  }

  .rx-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--rx-semantic-allowed);
    box-shadow: 0 0 6px var(--rx-semantic-allowed-glow);
  }

  .rx-output-caption {
    font-family: var(--rx-font-mono);
    font-size: 0.6875rem;
    color: var(--rx-text-3);
  }

  .rx-output-table-wrap {
    overflow-x: auto;
  }

  .rx-output-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--rx-font-mono);
    font-size: 0.75rem;
    text-align: left;
  }

  .rx-output-table th {
    padding: 0.625rem 1rem;
    background: var(--rx-surface-2);
    border-bottom: 1px solid var(--rx-border);
    color: var(--rx-text-3);
    font-weight: 600;
  }

  .rx-output-table td {
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--rx-border-subtle);
    color: var(--rx-text-2);
  }

  .rx-decision-chip {
    display: inline-block;
    padding: 0.125rem 0.375rem;
    border-radius: var(--rx-radius-xs);
    font-weight: 700;
    font-size: 0.6875rem;
  }

  .rx-decision-chip.allowed {
    color: var(--rx-semantic-allowed);
    background: var(--rx-semantic-allowed-surface);
  }

  .rx-decision-chip.denied {
    color: var(--rx-semantic-denied);
    background: var(--rx-semantic-denied-surface);
  }

  .rx-output-footer {
    padding: 0.875rem 1rem;
    background: var(--rx-surface-1);
    border-top: 1px solid var(--rx-border-subtle);
  }

  .rx-output-summary {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--rx-text-3);
    line-height: 1.45;
  }
</style>
