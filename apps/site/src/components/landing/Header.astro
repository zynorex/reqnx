---
import { siteConfig, withBase } from '../../site.config';
import Icon from '../common/Icon.astro';
import Button from '../common/Button.astro';
import { ThemeToggle } from '../common/ThemeToggle';
import Logo from '../brand/Logo.astro';

interface Props {
  currentPath?: string;
  isDocs?: boolean;
}

const { currentPath = '/', isDocs = false } = Astro.props;

const isLanding = currentPath === withBase('/') || currentPath === '/';

const navItems = [
  { label: 'Docs', href: withBase('/getting-started/') },
  { label: 'Algorithms', href: withBase('/algorithms/') },
  { label: 'Playground', href: withBase('/playground/') },
  { label: 'Status', href: isLanding ? '#status' : withBase('/#status') },
];

function isItemActive(itemHref: string, label: string): boolean {
  if (label === 'Docs') {
    if (currentPath.startsWith(withBase('/getting-started/'))) return true;
    if (isDocs && !currentPath.startsWith(withBase('/algorithms/')) && !currentPath.startsWith(withBase('/playground/'))) {
      return true;
    }
  }
  if (itemHref.startsWith('#')) {
    return false;
  }
  if (itemHref === withBase('/')) {
    return currentPath === withBase('/') || currentPath === '/';
  }
  return currentPath.startsWith(itemHref);
}
---

<a href="#main-content" class="rx-skip-link">
  Skip to main content
</a>

{!isDocs && <div id="rx-header-sentinel" aria-hidden="true" class="rx-sentinel"></div>}

<header class:list={['rx-header', { 'is-docs': isDocs, 'is-scrolled': isDocs }]} id="rx-site-header">
  <div class="rx-header__progress" aria-hidden="true" id="rx-header-progress"></div>
  <div class="rx-header__inner">
    <div class="rx-header__brand">
      <Logo size={30} showText={true} />
      <span class="rx-header__version" aria-label={`Version ${siteConfig.version}`}>
        {siteConfig.version}
      </span>
    </div>

    <nav class="rx-header__nav" aria-label="Main Navigation">
      <span class="rx-header__indicator" aria-hidden="true" id="rx-nav-indicator"></span>
      <ul class="rx-header__nav-list" role="list">
        {navItems.map((item) => {
          const isActive = isItemActive(item.href, item.label);
          return (
            <li>
              <a
                href={item.href}
                class:list={['rx-header__nav-link', { 'is-active': isActive }]}
                aria-current={isActive ? 'page' : undefined}
                data-nav-href={item.href}
              >
                {item.label}
              </a>
            </li>
          );
        })}
        <li>
          <a
            href={siteConfig.repo}
            class="rx-header__nav-link rx-header__nav-link--github"
            target="_blank"
            rel="noreferrer noopener"
            aria-label="GitHub Repository (opens in a new tab)"
            data-nav-href={siteConfig.repo}
          >
            <Icon name="github" size={18} ariaHidden={true} />
            <span class="rx-header__nav-label">GitHub</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="rx-header__actions">
      {
        isDocs && (
          <>
            <button
              type="button"
              class="rx-header__search-btn"
              id="rx-header-search-btn"
              aria-label="Search docs (Ctrl+K)"
              title="Search docs (Ctrl+K)"
            >
              <Icon name="search" size={15} ariaHidden={true} />
              <span class="rx-header__search-label">Search docs...</span>
              <kbd class="rx-header__search-kbd">Ctrl K</kbd>
            </button>

            <button
              type="button"
              class="rx-header__icon-btn rx-header__search-icon-btn"
              id="rx-header-search-icon-btn"
              aria-label="Search docs (Ctrl+K)"
              title="Search docs (Ctrl+K)"
            >
              <Icon name="search" size={18} ariaHidden={true} />
            </button>

            <button
              type="button"
              class="rx-header__icon-btn rx-header__docs-sidebar-btn"
              id="rx-docs-sidebar-toggle"
              aria-label="Toggle documentation outline"
              title="Docs Table of Contents"
            >
              <Icon name="book" size={18} ariaHidden={true} />
            </button>
          </>
        )
      }

      <ThemeToggle client:load />

      {
        !isDocs && (
          <Button href={withBase('/getting-started/')} variant="primary" size="sm" className="rx-header__cta">
            Get started
          </Button>
        )
      }

      <button
        type="button"
        id="rx-menu-toggle"
        class="btn rx-header__menu-btn"
        data-variant="secondary"
        data-size="sm"
        data-icon-only="true"
        aria-expanded="false"
        aria-controls="rx-mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <span class="rx-header__menu-icon-open">
          <Icon name="menu" size={20} ariaHidden={true} />
        </span>
        <span class="rx-header__menu-icon-close">
          <Icon name="close" size={20} ariaHidden={true} />
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Sheet Drawer -->
  <div id="rx-mobile-menu" class="rx-mobile-sheet" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
    <div class="rx-mobile-sheet__backdrop" id="rx-sheet-backdrop"></div>
    <div class="rx-mobile-sheet__panel">
      {
        isDocs && (
          <button
            type="button"
            class="rx-mobile-sheet__search-btn"
            id="rx-mobile-search-trigger"
            aria-label="Search documentation"
          >
            <Icon name="search" size={16} ariaHidden={true} />
            <span>Search documentation...</span>
            <kbd class="rx-header__search-kbd">Ctrl K</kbd>
          </button>
        )
      }

      <nav class="rx-mobile-sheet__nav" aria-label="Mobile Navigation Links">
        <ul class="rx-mobile-sheet__list" role="list">
          {navItems.map((item) => {
            const isActive = isItemActive(item.href, item.label);
            return (
              <li>
                <a href={item.href} class:list={['rx-mobile-sheet__link', { 'is-active': isActive }]}>
                  {item.label}
                </a>
              </li>
            );
          })}
          <li>
            <a
              href={siteConfig.repo}
              class="rx-mobile-sheet__link rx-mobile-sheet__link--github"
              target="_blank"
              rel="noreferrer noopener"
            >
              <Icon name="github" size={18} ariaHidden={true} />
              <span>GitHub</span>
              <span class="rx-sr-only">(opens in a new tab)</span>
            </a>
          </li>
        </ul>
      </nav>

      {
        isDocs && (
          <button
            type="button"
            class="rx-mobile-sheet__outline-btn"
            id="rx-mobile-outline-btn"
            aria-label="Browse documentation outline and sections"
          >
            <Icon name="book" size={18} ariaHidden={true} />
            <span>Browse Docs Outline / TOC</span>
            <span class="rx-mobile-sheet__arrow">&rarr;</span>
          </button>
        )
      }

      {
        !isDocs && (
          <div class="rx-mobile-sheet__actions">
            <Button href={withBase('/getting-started/')} variant="primary" size="md" block={true}>
              Get started
            </Button>
          </div>
        )
      }
    </div>
  </div>
</header>

<style>
  @layer components {
    .rx-skip-link {
      position: absolute;
      top: -100px;
      left: 1rem;
      background: var(--rx-accent-indigo);
      color: #ffffff;
      padding: 0.5rem 1rem;
      border-radius: var(--rx-radius-sm);
      font-size: var(--rx-font-small);
      font-weight: 600;
      z-index: 1000;
      text-decoration: none;
      transition: top var(--rx-transition-fast);
    }

    .rx-skip-link:focus-visible {
      top: 1rem;
      outline: var(--rx-focus-ring);
    }

    .rx-sentinel {
      position: absolute;
      top: 0;
      left: 0;
      height: 1px;
      width: 1px;
      pointer-events: none;
      visibility: hidden;
    }

    .rx-header__progress {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--rx-accent-cyan);
      transform-origin: 0 50%;
      transform: scaleX(0);
      pointer-events: none;
      z-index: 101;
      display: none;
    }

    @supports (animation-timeline: scroll(root)) {
      @media (prefers-reduced-motion: no-preference) {
        html:not([data-motion="reduced"]) .rx-header__progress {
          display: block;
          animation: rx-scroll-progress linear;
          animation-timeline: scroll(root);
        }
      }
    }

    @keyframes rx-scroll-progress {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }

    .rx-header {
      position: sticky;
      top: 0;
      left: 0;
      right: 0;
      height: 64px;
      z-index: 100;
      background: transparent;
      border-bottom: 1px solid transparent;
      transition:
        background-color var(--rx-dur-base) var(--rx-ease-out),
        border-color var(--rx-dur-base) var(--rx-ease-out),
        backdrop-filter var(--rx-dur-base) var(--rx-ease-out);
    }

    @media (prefers-reduced-motion: reduce) {
      .rx-header {
        transition: none;
      }
    }
    html[data-motion="reduced"] .rx-header {
      transition: none;
    }

    .rx-header.is-docs,
    .rx-header.is-scrolled {
      background-color: color-mix(in srgb, var(--rx-surface-1) 85%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom-color: var(--rx-border);
    }

    .rx-header.is-docs .rx-header__inner {
      max-width: 1440px;
    }

    .rx-header__inner {
      max-width: 1280px;
      height: 100%;
      margin: 0 auto;
      padding: 0 clamp(1rem, 4vw, 2.5rem);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .rx-header__brand {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      flex-shrink: 0;
    }

    .rx-header__logo {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
      color: var(--rx-text-1);
    }

    .rx-header__logo:focus-visible {
      outline: var(--rx-focus-ring);
      border-radius: var(--rx-radius-xs);
    }

    .rx-header__wordmark {
      font-family: var(--rx-font-mono);
      font-size: 1.125rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--rx-text-1);
    }

    .rx-header__version {
      font-family: var(--rx-font-mono);
      font-size: 0.6875rem;
      font-weight: 600;
      padding: 0.125rem 0.375rem;
      border-radius: var(--rx-radius-xs);
      background: var(--rx-surface-3);
      color: var(--rx-text-2);
      border: 1px solid var(--rx-border-subtle);
    }

    @media (max-width: 480px) {
      .rx-header {
        height: 56px;
      }
      .rx-header__version {
        display: none;
      }
    }

    .rx-header__nav {
      display: none;
      position: relative;
    }

    @media (min-width: 768px) {
      .rx-header__nav {
        display: block;
      }
    }

    .rx-header__indicator {
      position: absolute;
      top: 50%;
      left: 0;
      transform: translateY(-50%);
      height: 32px;
      border-radius: var(--rx-radius-sm);
      background: var(--rx-surface-2);
      border: 1px solid var(--rx-border-subtle);
      pointer-events: none;
      opacity: 0;
      transition:
        transform var(--rx-dur-panel) var(--rx-ease-spring),
        opacity var(--rx-dur-fast) var(--rx-ease-out);
      z-index: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .rx-header__indicator {
        transition: none;
      }
    }
    html[data-motion="reduced"] .rx-header__indicator {
      transition: none;
    }

    .rx-header__nav-list {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .rx-header__nav-link {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.375rem 0.75rem;
      border-radius: var(--rx-radius-sm);
      font-size: var(--rx-font-small);
      font-weight: 500;
      color: var(--rx-text-2);
      text-decoration: none;
      background-color: transparent;
      transition: color var(--rx-dur-fast) var(--rx-ease-out);
    }

    .rx-header__nav-link:hover {
      color: var(--rx-text-1);
    }

    .rx-header__nav-link.is-active {
      color: var(--rx-text-1);
      font-weight: 600;
    }

    .rx-header__nav-link:focus-visible {
      outline: var(--rx-focus-ring);
    }

    .rx-header__actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .rx-header__search-btn {
      display: none;
      align-items: center;
      gap: 0.5rem;
      background: var(--rx-surface-2);
      border: 1px solid var(--rx-border);
      color: var(--rx-text-2);
      padding: 0.35rem 0.65rem;
      border-radius: var(--rx-radius-sm);
      font-family: var(--rx-font-mono);
      font-size: 0.75rem;
      cursor: pointer;
      min-height: 36px;
      min-width: 170px;
      justify-content: space-between;
      transition:
        background-color var(--rx-dur-fast) var(--rx-ease-out),
        border-color var(--rx-dur-fast) var(--rx-ease-out),
        color var(--rx-dur-fast) var(--rx-ease-out);
    }

    @media (min-width: 768px) {
      .rx-header__search-btn {
        display: inline-flex;
      }
    }

    .rx-header__search-btn:hover {
      background: var(--rx-surface-3);
      color: var(--rx-text-1);
      border-color: var(--rx-border-hover);
    }

    .rx-header__search-btn:focus-visible {
      outline: var(--rx-focus-ring);
    }

    .rx-header__search-label {
      flex: 1;
      text-align: left;
      margin-left: 0.15rem;
    }

    .rx-header__search-kbd {
      font-family: var(--rx-font-mono);
      font-size: 0.6875rem;
      padding: 0.1rem 0.35rem;
      border-radius: var(--rx-radius-xs);
      background: var(--rx-surface-3);
      border: 1px solid var(--rx-border-subtle);
      color: var(--rx-text-3);
      line-height: 1;
    }

    .rx-header__icon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      padding: 0;
      background: var(--rx-surface-2);
      border: 1px solid var(--rx-border);
      border-radius: var(--rx-radius-sm);
      color: var(--rx-text-2);
      cursor: pointer;
      transition:
        background-color var(--rx-dur-fast) var(--rx-ease-out),
        border-color var(--rx-dur-fast) var(--rx-ease-out),
        color var(--rx-dur-fast) var(--rx-ease-out);
    }

    @media (min-width: 768px) {
      .rx-header__icon-btn {
        display: none;
      }
    }

    .rx-header__icon-btn:hover {
      background: var(--rx-surface-3);
      color: var(--rx-text-1);
      border-color: var(--rx-border-hover);
    }

    .rx-header__icon-btn:focus-visible {
      outline: var(--rx-focus-ring);
    }

    .rx-header__cta {
      display: none;
    }

    @media (min-width: 640px) {
      .rx-header__cta {
        display: inline-flex;
      }
    }

    .rx-header__menu-btn {
      display: inline-flex;
    }

    @media (min-width: 768px) {
      .rx-header__menu-btn {
        display: none;
      }
    }

    .rx-header__menu-icon-close {
      display: none;
    }

    .rx-header.menu-open .rx-header__menu-icon-open {
      display: none;
    }

    .rx-header.menu-open .rx-header__menu-icon-close {
      display: inline-block;
    }

    @media (min-width: 768px) {
      .rx-header__menu-btn {
        display: none;
      }
    }

    /* Mobile Sheet Drawer */
    .rx-mobile-sheet {
      display: none;
      position: fixed;
      top: 56px;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 99;
    }

    .rx-mobile-sheet.is-open {
      display: block;
    }

    .rx-mobile-sheet__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
    }

    .rx-mobile-sheet__panel {
      position: relative;
      background: var(--rx-surface-1);
      border-bottom: 1px solid var(--rx-border);
      padding: 1.5rem clamp(1rem, 4vw, 2rem) 2rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      max-height: 80vh;
      overflow-y: auto;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
    }

    .rx-mobile-sheet__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .rx-mobile-sheet__link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      min-height: 44px;
      border-radius: var(--rx-radius-sm);
      font-size: 1.0625rem;
      font-weight: 500;
      color: var(--rx-text-1);
      text-decoration: none;
      background: var(--rx-surface-2);
      border: 1px solid var(--rx-border-subtle);
      transition:
        background-color var(--rx-dur-fast) var(--rx-ease-out),
        border-color var(--rx-dur-fast) var(--rx-ease-out);
    }

    .rx-mobile-sheet__link:hover {
      background: var(--rx-surface-3);
      border-color: var(--rx-border);
    }

    .rx-mobile-sheet__link:focus-visible {
      outline: var(--rx-focus-ring);
    }

    .rx-mobile-sheet__actions {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .rx-mobile-sheet__search-btn {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
      min-height: 44px;
      padding: 0.625rem 1rem;
      background: var(--rx-surface-2);
      border: 1px solid var(--rx-border);
      border-radius: var(--rx-radius-sm);
      color: var(--rx-text-2);
      font-family: var(--rx-font-sans);
      font-size: 0.9375rem;
      cursor: pointer;
      transition:
        background-color var(--rx-dur-fast) var(--rx-ease-out),
        border-color var(--rx-dur-fast) var(--rx-ease-out);
    }

    .rx-mobile-sheet__search-btn:hover {
      background: var(--rx-surface-3);
      border-color: var(--rx-border-hover);
      color: var(--rx-text-1);
    }

    .rx-mobile-sheet__search-btn kbd {
      margin-left: auto;
    }

    .rx-mobile-sheet__outline-btn {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
      min-height: 44px;
      padding: 0.75rem 1rem;
      background: var(--sl-color-accent-low, rgba(79, 70, 229, 0.18));
      border: 1px solid var(--rx-border-hover);
      border-radius: var(--rx-radius-sm);
      color: var(--rx-text-1);
      font-family: var(--rx-font-sans);
      font-size: 0.9375rem;
      font-weight: 600;
      cursor: pointer;
      transition: background-color var(--rx-dur-fast) var(--rx-ease-out);
    }

    .rx-mobile-sheet__outline-btn:hover {
      background: var(--rx-accent-indigo);
      color: #ffffff;
    }

    .rx-mobile-sheet__arrow {
      margin-left: auto;
    }

    .rx-mobile-sheet__cta {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 0.75rem 1.25rem;
      font-size: 1rem;
      font-weight: 600;
      color: #ffffff;
      background: var(--rx-accent-indigo);
      border-radius: var(--rx-radius-sm);
      text-decoration: none;
    }

    .rx-sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }
  }
</style>

<script>
  import { isMotionReduced } from '../../motion/kill-switch.js';

  // E1: Header scroll sentinel observation
  const sentinel = document.getElementById('rx-header-sentinel');
  const header = document.getElementById('rx-site-header');

  if (sentinel && header && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          header.classList.add('is-scrolled');
        } else {
          header.classList.remove('is-scrolled');
        }
      },
      { rootMargin: '0px', threshold: 0 }
    );
    observer.observe(sentinel);
  }

  // E2: Nav indicator & scrollspy
  const nav = document.querySelector<HTMLElement>('.rx-header__nav');
  const indicator = document.getElementById('rx-nav-indicator');
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.rx-header__nav-link'));

  if (nav && indicator && navLinks.length > 0) {
    function positionIndicator(target: HTMLElement | null) {
      if (!target || !indicator || !nav) {
        if (indicator) indicator.style.opacity = '0';
        return;
      }
      const navRect = nav.getBoundingClientRect();
      const targetRect = target.getBoundingClientRect();
      const left = targetRect.left - navRect.left;
      const width = targetRect.width;

      indicator.style.transform = `translate3d(${left}px, -50%, 0)`;
      indicator.style.width = `${width}px`;
      indicator.style.opacity = '1';
    }

    function getActiveLink(): HTMLAnchorElement | null {
      return navLinks.find((l) => l.classList.contains('is-active')) || null;
    }

    // Set initial position to active link if present
    const initialActive = getActiveLink();
    if (initialActive) {
      positionIndicator(initialActive);
    }

    navLinks.forEach((link) => {
      link.addEventListener('mouseenter', () => positionIndicator(link));
      link.addEventListener('focus', () => positionIndicator(link));
    });

    nav.addEventListener('mouseleave', () => {
      const active = getActiveLink();
      positionIndicator(active);
    });

    // Anchor smooth scrolling with header offset
    navLinks.forEach((link) => {
      const href = link.getAttribute('href');
      if (href && href.startsWith('#')) {
        link.addEventListener('click', (e) => {
          const target = document.querySelector(href);
          if (target && !isMotionReduced()) {
            e.preventDefault();
            const headerHeight = header?.offsetHeight || 64;
            const top = target.getBoundingClientRect().top + window.scrollY - headerHeight;
            window.scrollTo({ top, behavior: 'smooth' });
            history.pushState(null, '', href);
          }
        });
      }
    });

    // Scrollspy for #status section
    const statusSection = document.getElementById('status');
    if (statusSection && 'IntersectionObserver' in window) {
      const spyObserver = new IntersectionObserver(
        ([entry]) => {
          const statusLink = navLinks.find((l) => l.getAttribute('href') === '#status');
          if (statusLink) {
            if (entry.isIntersecting) {
              navLinks.forEach((l) => l.classList.remove('is-active'));
              statusLink.classList.add('is-active');
              positionIndicator(statusLink);
            } else {
              statusLink.classList.remove('is-active');
            }
          }
        },
        { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
      );
      spyObserver.observe(statusSection);
    }
  }

  // Mobile sheet drawer state management & focus trap
  const menuToggle = document.getElementById('rx-menu-toggle');
  const mobileSheet = document.getElementById('rx-mobile-menu');
  const backdrop = document.getElementById('rx-sheet-backdrop');

  if (menuToggle && mobileSheet && header) {
    let isOpen = false;

    function openMenu() {
      isOpen = true;
      header?.classList.add('menu-open');
      mobileSheet?.classList.add('is-open');
      mobileSheet?.setAttribute('aria-hidden', 'false');
      menuToggle?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';

      const firstLink = mobileSheet?.querySelector<HTMLAnchorElement>('a');
      firstLink?.focus();
    }

    function closeMenu() {
      isOpen = false;
      header?.classList.remove('menu-open');
      mobileSheet?.classList.remove('is-open');
      mobileSheet?.setAttribute('aria-hidden', 'true');
      menuToggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      menuToggle?.focus();
    }

    menuToggle.addEventListener('click', () => {
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    backdrop?.addEventListener('click', closeMenu);

    const sheetLinks = mobileSheet.querySelectorAll('a');
    sheetLinks.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    window.addEventListener('keydown', (e) => {
      if (!isOpen) return;

      if (e.key === 'Escape') {
        closeMenu();
        return;
      }

      if (e.key === 'Tab') {
        const focusable = mobileSheet.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled])'
        );
        if (focusable.length === 0) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }

  // E4: Search trigger wiring
  function triggerSearch() {
    const searchBtn = document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]');
    if (searchBtn) {
      searchBtn.click();
    }
  }

  document.getElementById('rx-header-search-btn')?.addEventListener('click', triggerSearch);
  document.getElementById('rx-header-search-icon-btn')?.addEventListener('click', triggerSearch);
  document.getElementById('rx-mobile-search-trigger')?.addEventListener('click', () => {
    document.getElementById('rx-mobile-sheet')?.classList.remove('is-open');
    triggerSearch();
  });

  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
      e.preventDefault();
      triggerSearch();
    }
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
      e.preventDefault();
      triggerSearch();
    }
  });

  // E5: Docs outline mobile toggle wiring
  function toggleDocsSidebar() {
    const starlightMenuBtn = document.querySelector<HTMLButtonElement>('starlight-menu-button button');
    if (starlightMenuBtn) {
      starlightMenuBtn.click();
    }
  }

  document.getElementById('rx-docs-sidebar-toggle')?.addEventListener('click', toggleDocsSidebar);
  document.getElementById('rx-mobile-outline-btn')?.addEventListener('click', () => {
    const menuToggleBtn = document.getElementById('rx-menu-toggle');
    if (menuToggleBtn && menuToggleBtn.getAttribute('aria-expanded') === 'true') {
      menuToggleBtn.click();
    }
    toggleDocsSidebar();
  });
</script>
