    .rx-nav-popover__search-btn kbd {
      margin-left: auto;
      font-family: var(--rx-font-mono);
      font-size: 0.625rem;
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: var(--rx-text-3);
    }

    /* Nav List */
    .rx-nav-popover__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    /* Navigation Row */
    .rx-nav-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.55rem 0.65rem;
      border-radius: 10px;
      text-decoration: none;
      background: transparent;
      border: 1px solid transparent;
      transition:
        background-color var(--rx-dur-fast) var(--rx-ease-out),
        border-color var(--rx-dur-fast) var(--rx-ease-out),
        transform var(--rx-dur-instant) var(--rx-ease-out);
    }

    .rx-nav-row:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.08);
      transform: translateX(2px);
    }

    .rx-nav-row.is-active {
      background: rgba(245, 158, 11, 0.08);
      border-color: rgba(245, 158, 11, 0.25);
    }

    .rx-nav-row:focus-visible {
      outline: 2px solid #fbbf24;
      outline-offset: -2px;
    }

    /* Icon Box per accent */
    .rx-nav-row__icon-box {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      flex-shrink: 0;
      transition: transform var(--rx-dur-fast) var(--rx-ease-out);
    }

    .rx-nav-row:hover .rx-nav-row__icon-box {
      transform: scale(1.08);
    }

    .rx-nav-row--amber .rx-nav-row__icon-box {
      background: rgba(245, 158, 11, 0.14);
      border: 1px solid rgba(245, 158, 11, 0.28);
      color: #fbbf24;
    }

    .rx-nav-row--emerald .rx-nav-row__icon-box {
      background: rgba(16, 185, 129, 0.14);
      border: 1px solid rgba(16, 185, 129, 0.28);
      color: #10b981;
    }

    .rx-nav-row--violet .rx-nav-row__icon-box {
      background: rgba(139, 92, 246, 0.14);
      border: 1px solid rgba(139, 92, 246, 0.28);
      color: #c084fc;
    }

    .rx-nav-row--gold .rx-nav-row__icon-box {
      background: rgba(251, 191, 36, 0.14);
      border: 1px solid rgba(251, 191, 36, 0.28);
      color: #fbbf24;
    }

    .rx-nav-row--github .rx-nav-row__icon-box {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #f8fafc;
    }

    /* Info */
    .rx-nav-row__info {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      min-width: 0;
      flex: 1;
    }

    .rx-nav-row__title {
      font-size: 0.875rem;
      font-weight: 550;
      color: var(--rx-text-1);
      line-height: 1.25;
    }

    .rx-nav-row__desc {
      font-size: 0.6875rem;
      color: var(--rx-text-3);
      line-height: 1.3;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .rx-nav-row__badge {
      font-family: var(--rx-font-mono);
      font-size: 0.5625rem;
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.09);
      color: var(--rx-text-3);
      font-weight: 550;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .rx-nav-row.is-active .rx-nav-row__badge {
      background: rgba(245, 158, 11, 0.14);
      border-color: rgba(245, 158, 11, 0.3);
      color: #fbbf24;
    }

    .rx-nav-row__arrow {
      color: var(--rx-text-3);
      font-size: 0.75rem;
      transition: transform var(--rx-dur-fast) var(--rx-ease-out), color var(--rx-dur-fast);
      margin-left: 0.15rem;
    }

    .rx-nav-row:hover .rx-nav-row__arrow {
      transform: translateX(3px);
      color: #fbbf24;
    }

    /* Outline Button for Docs */
    .rx-nav-popover__outline-btn {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      width: 100%;
      padding: 0.6rem 0.85rem;
      background: rgba(245, 158, 11, 0.08);
      border: 1px solid rgba(245, 158, 11, 0.2);
      border-radius: 9px;
      color: #fbbf24;
      font-size: 0.8125rem;
      font-weight: 550;
      cursor: pointer;
      transition: background-color var(--rx-dur-fast) var(--rx-ease-out);
    }

    .rx-nav-popover__outline-btn:hover {
      background: rgba(245, 158, 11, 0.15);
    }

    .rx-nav-popover__arrow {
      margin-left: auto;
    }

    /* Popover CTA Action */
    .rx-nav-popover__cta-wrap {
      margin-top: 0.25rem;
    }

    .rx-nav-popover__cta-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 0.65rem 1rem;
      border-radius: 10px;
      text-decoration: none;
      background: linear-gradient(135deg, #1c2230 0%, #111520 100%);
      border: 1px solid rgba(245, 158, 11, 0.35);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.12),
        0 4px 16px -2px rgba(245, 158, 11, 0.2);
      color: #ffffff;
      font-size: 0.875rem;
      font-weight: 600;
      transition:
        background var(--rx-dur-fast) var(--rx-ease-out),
        border-color var(--rx-dur-fast) var(--rx-ease-out),
        box-shadow var(--rx-dur-fast) var(--rx-ease-out),
        transform var(--rx-dur-instant) var(--rx-ease-out);
    }

    .rx-nav-popover__cta-btn:hover {
      background: linear-gradient(135deg, #242c3e 0%, #151a28 100%);
      border-color: #fbbf24;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.18),
        0 6px 20px -2px rgba(245, 158, 11, 0.35);
      transform: translateY(-1px);
    }

    .rx-nav-popover__cta-btn:active {
      transform: translateY(0);
    }

    /* Telemetry Ribbon */
    .rx-nav-popover__telemetry {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      padding-top: 0.6rem;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      font-family: var(--rx-font-mono);
      font-size: 0.5625rem;
      letter-spacing: 0.04em;
      color: var(--rx-text-3);
      text-transform: uppercase;
      user-select: none;
    }

    .rx-nav-popover__telem-dot {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: #fbbf24;
      box-shadow: 0 0 6px rgba(251, 191, 36, 0.7);
    }

    /* Light Mode Overrides for Popover */
    :root[data-theme='light'] .rx-nav-popover {
      background: rgba(255, 255, 255, 0.98);
      border-color: rgba(15, 23, 42, 0.12);
      box-shadow:
        0 20px 48px -12px rgba(15, 23, 42, 0.16),
        0 0 0 1px rgba(15, 23, 42, 0.05),
        0 0 24px -4px rgba(217, 119, 6, 0.12);
    }

    :root[data-theme='light'] .rx-nav-popover__header {
      border-bottom-color: rgba(15, 23, 42, 0.08);
    }

    :root[data-theme='light'] .rx-nav-row:hover {
      background: rgba(15, 23, 42, 0.04);
      border-color: rgba(15, 23, 42, 0.08);
    }

    :root[data-theme='light'] .rx-nav-row.is-active {
      background: rgba(217, 119, 6, 0.08);
      border-color: rgba(217, 119, 6, 0.25);
    }

    :root[data-theme='light'] .rx-nav-row--github .rx-nav-row__icon-box {
      background: rgba(15, 23, 42, 0.06);
      border-color: rgba(15, 23, 42, 0.1);
      color: #0f172a;
    }

    :root[data-theme='light'] .rx-nav-popover__cta-btn {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      border-color: rgba(217, 119, 6, 0.4);
      color: #ffffff;
      box-shadow: 0 4px 14px -2px rgba(15, 23, 42, 0.25);
    }

    :root[data-theme='light'] .rx-nav-popover__telemetry {
      border-top-color: rgba(15, 23, 42, 0.07);
    }

    .rx-sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }
  }
</style>

<script>
  import { isMotionReduced } from '../../motion/kill-switch.js';

  // E1: Header scroll sentinel observation
  const sentinel = document.getElementById('rx-header-sentinel');
  const header = document.getElementById('rx-site-header');

  if (sentinel && header && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          header.classList.add('is-scrolled');
        } else {
          header.classList.remove('is-scrolled');
        }
      },
      { rootMargin: '0px', threshold: 0 }
    );
    observer.observe(sentinel);
  }

  // E2: Nav indicator & scrollspy
  const nav = document.querySelector<HTMLElement>('.rx-header__nav');
  const indicator = document.getElementById('rx-nav-indicator');
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.rx-header__nav-link'));

  if (nav && indicator && navLinks.length > 0) {
    function positionIndicator(target: HTMLElement | null) {
      if (!target || !indicator || !nav) {
        if (indicator) indicator.style.opacity = '0';
        return;
      }
      const navRect = nav.getBoundingClientRect();
      const targetRect = target.getBoundingClientRect();
      const left = targetRect.left - navRect.left;
      const width = targetRect.width;

      indicator.style.transform = `translate3d(${left}px, -50%, 0)`;
      indicator.style.width = `${width}px`;
      indicator.style.opacity = '1';
    }

    function getActiveLink(): HTMLAnchorElement | null {
      return navLinks.find((l) => l.classList.contains('is-active')) || null;
    }

    // Set initial position to active link if present
    const initialActive = getActiveLink();
    if (initialActive) {
      positionIndicator(initialActive);
    }

    navLinks.forEach((link) => {
      link.addEventListener('mouseenter', () => positionIndicator(link));
      link.addEventListener('focus', () => positionIndicator(link));
    });

    nav.addEventListener('mouseleave', () => {
      const active = getActiveLink();
      positionIndicator(active);
    });

    // Anchor smooth scrolling with header offset
    navLinks.forEach((link) => {
      const href = link.getAttribute('href');
      if (href && href.startsWith('#')) {
        link.addEventListener('click', (e) => {
          const target = document.querySelector(href);
          if (target && !isMotionReduced()) {
            e.preventDefault();
            const headerHeight = header?.offsetHeight || 64;
            const top = target.getBoundingClientRect().top + window.scrollY - headerHeight;
            window.scrollTo({ top, behavior: 'smooth' });
            history.pushState(null, '', href);
          }
        });
      }
    });

    // Scrollspy for #status section
    const statusSection = document.getElementById('status');
    if (statusSection && 'IntersectionObserver' in window) {
      const spyObserver = new IntersectionObserver(
        ([entry]) => {
          const statusLink = navLinks.find((l) => l.getAttribute('href') === '#status');
          if (statusLink) {
            if (entry.isIntersecting) {
              navLinks.forEach((l) => l.classList.remove('is-active'));
              statusLink.classList.add('is-active');
              positionIndicator(statusLink);
            } else {
              statusLink.classList.remove('is-active');
            }
          }
        },
        { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
      );
      spyObserver.observe(statusSection);
    }
  }

  // Mobile sheet drawer state management & focus trap
  const menuToggle = document.getElementById('rx-menu-toggle');
  const mobileSheet = document.getElementById('rx-mobile-menu');
  const backdrop = document.getElementById('rx-sheet-backdrop');

  if (menuToggle && mobileSheet && header) {
    let isOpen = false;

    function openMenu() {
      isOpen = true;
      header?.classList.add('menu-open');
      mobileSheet?.classList.add('is-open');
      mobileSheet?.setAttribute('aria-hidden', 'false');
      menuToggle?.setAttribute('aria-expanded', 'true');
      if (window.innerWidth < 768) {
        document.body.style.overflow = 'hidden';
      }

      const firstLink = mobileSheet?.querySelector<HTMLAnchorElement>('a');
      firstLink?.focus();
    }

    function closeMenu() {
      isOpen = false;
      header?.classList.remove('menu-open');
      mobileSheet?.classList.remove('is-open');
      mobileSheet?.setAttribute('aria-hidden', 'true');
      menuToggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      menuToggle?.focus();
    }

    menuToggle.addEventListener('click', () => {
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    backdrop?.addEventListener('click', closeMenu);

    const sheetLinks = mobileSheet.querySelectorAll('a');
    sheetLinks.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    window.addEventListener('keydown', (e) => {
      if (!isOpen) return;

      if (e.key === 'Escape') {
        closeMenu();
        return;
      }

      if (e.key === 'Tab') {
        const focusable = mobileSheet.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled])'
        );
        if (focusable.length === 0) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }

  // E4: Search trigger wiring
  function triggerSearch() {
    const searchBtn = document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]');
    if (searchBtn) {
      searchBtn.click();
    }
  }

  document.getElementById('rx-header-search-btn')?.addEventListener('click', triggerSearch);
  document.getElementById('rx-header-search-icon-btn')?.addEventListener('click', triggerSearch);
  document.getElementById('rx-mobile-search-trigger')?.addEventListener('click', () => {
    document.getElementById('rx-mobile-sheet')?.classList.remove('is-open');
    triggerSearch();
  });

  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
      e.preventDefault();
      triggerSearch();
    }
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
      e.preventDefault();
      triggerSearch();
    }
  });

  // E5: Docs outline mobile toggle wiring
  function toggleDocsSidebar() {
    const starlightMenuBtn = document.querySelector<HTMLButtonElement>('starlight-menu-button button');
    if (starlightMenuBtn) {
      starlightMenuBtn.click();
    }
  }

  document.getElementById('rx-docs-sidebar-toggle')?.addEventListener('click', toggleDocsSidebar);
  document.getElementById('rx-mobile-outline-btn')?.addEventListener('click', () => {
    const menuToggleBtn = document.getElementById('rx-menu-toggle');
    if (menuToggleBtn && menuToggleBtn.getAttribute('aria-expanded') === 'true') {
      menuToggleBtn.click();
    }
    toggleDocsSidebar();
  });
</script>
