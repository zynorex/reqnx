---
import { siteConfig, withBase } from '../../site.config';
import Icon from '../common/Icon.astro';
import Button from '../common/Button.astro';
import { ThemeToggle } from '../common/ThemeToggle';
import Logo from '../brand/Logo.astro';

interface Props {
  currentPath?: string;
  isDocs?: boolean;
}

const { currentPath = '/', isDocs = false } = Astro.props;

const isLanding = currentPath === withBase('/') || currentPath === '/';

interface NavItemMeta {
  label: string;
  href: string;
  icon: 'book' | 'terminal' | 'play' | 'dashed-circle';
  desc: string;
  badge: string;
  accentClass: string;
}

const navItems: NavItemMeta[] = [
  {
    label: 'Docs',
    href: withBase('/getting-started/'),
    icon: 'book',
    desc: 'Architecture, specs & API guides',
    badge: 'v0.1.0',
    accentClass: 'rx-nav-row--amber',
  },
  {
    label: 'Algorithms',
    href: withBase('/algorithms/'),
    icon: 'terminal',
    desc: 'Token bucket, sliding window, fixed window',
    badge: '5 algos',
    accentClass: 'rx-nav-row--emerald',
  },
  {
    label: 'Playground',
    href: withBase('/playground/'),
    icon: 'play',
    desc: 'Simulate bursts, jitter & token refill live',
    badge: 'Live',
    accentClass: 'rx-nav-row--violet',
  },
  {
    label: 'Status',
    href: isLanding ? '#status' : withBase('/#status'),
    icon: 'dashed-circle',
    desc: 'Differential test suite & benchmarks',
    badge: '100% pass',
    accentClass: 'rx-nav-row--gold',
  },
];

function isItemActive(itemHref: string, label: string): boolean {
  if (label === 'Docs') {
    if (currentPath.startsWith(withBase('/getting-started/'))) return true;
    if (isDocs && !currentPath.startsWith(withBase('/algorithms/')) && !currentPath.startsWith(withBase('/playground/'))) {
      return true;
    }
  }
  if (itemHref.startsWith('#')) {
    return false;
  }
  if (itemHref === withBase('/')) {
    return currentPath === withBase('/') || currentPath === '/';
  }
  return currentPath.startsWith(itemHref);
}
---

<a href="#main-content" class="rx-skip-link">
  Skip to main content
</a>

{!isDocs && <div id="rx-header-sentinel" aria-hidden="true" class="rx-sentinel"></div>}

<header class:list={['rx-header', { 'is-docs': isDocs, 'is-scrolled': isDocs }]} id="rx-site-header">
  <div class="rx-header__progress" aria-hidden="true" id="rx-header-progress"></div>
  <div class="rx-header__inner">
    <div class="rx-header__brand">
      <Logo size={30} showText={true} />
      <span class="rx-header__version" aria-label={`Version ${siteConfig.version}`}>
        {siteConfig.version}
      </span>
    </div>

    <nav class="rx-header__nav" aria-label="Main Navigation">
      <span class="rx-header__indicator" aria-hidden="true" id="rx-nav-indicator"></span>
      <ul class="rx-header__nav-list" role="list">
        {navItems.map((item) => {
          const isActive = isItemActive(item.href, item.label);
          return (
            <li>
              <a
                href={item.href}
                class:list={['rx-header__nav-link', { 'is-active': isActive }]}
                aria-current={isActive ? 'page' : undefined}
                data-nav-href={item.href}
              >
                {item.label}
              </a>
            </li>
          );
        })}
        <li>
          <a
            href={siteConfig.repo}
            class="rx-header__nav-link rx-header__nav-link--github"
            target="_blank"
            rel="noreferrer noopener"
            aria-label="GitHub Repository (opens in a new tab)"
            data-nav-href={siteConfig.repo}
          >
            <Icon name="github" size={18} ariaHidden={true} />
            <span class="rx-header__nav-label">GitHub</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="rx-header__actions">
      {
        isDocs && (
          <>
            <button
              type="button"
              class="rx-header__search-btn"
              id="rx-header-search-btn"
              aria-label="Search docs (Ctrl+K)"
              title="Search docs (Ctrl+K)"
            >
              <Icon name="search" size={15} ariaHidden={true} />
              <span class="rx-header__search-label">Search docs...</span>
              <kbd class="rx-header__search-kbd">Ctrl K</kbd>
            </button>

            <button
              type="button"
              class="rx-header__icon-btn rx-header__search-icon-btn"
              id="rx-header-search-icon-btn"
              aria-label="Search docs (Ctrl+K)"
              title="Search docs (Ctrl+K)"
            >
              <Icon name="search" size={18} ariaHidden={true} />
            </button>

            <button
              type="button"
              class="rx-header__icon-btn rx-header__docs-sidebar-btn"
              id="rx-docs-sidebar-toggle"
              aria-label="Toggle documentation outline"
              title="Docs Table of Contents"
            >
              <Icon name="book" size={18} ariaHidden={true} />
            </button>
          </>
        )
      }

      <ThemeToggle client:load />

      {
        !isDocs && (
          <Button href={withBase('/getting-started/')} variant="primary" size="sm" className="rx-header__cta">
            Get started
          </Button>
        )
      }

      <button
        type="button"
        id="rx-menu-toggle"
        class="btn rx-header__menu-btn"
        data-variant="secondary"
        data-size="sm"
        data-icon-only="true"
        aria-expanded="false"
        aria-controls="rx-mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <span class="rx-header__menu-icon-open">
          <Icon name="menu" size={20} ariaHidden={true} />
        </span>
        <span class="rx-header__menu-icon-close">
          <Icon name="close" size={20} ariaHidden={true} />
        </span>
      </button>
    </div>
  </div>

  <!-- Engineering Navigation Command Popover -->
  <div id="rx-mobile-menu" class="rx-mobile-sheet" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Navigation Menu">
    <div class="rx-mobile-sheet__backdrop" id="rx-sheet-backdrop"></div>
    <div class="rx-mobile-sheet__panel rx-nav-popover">
      {/* Popover Header */}
      <div class="rx-nav-popover__header">
        <div class="rx-nav-popover__status">
          <span class="rx-nav-popover__pulse-led" aria-hidden="true"></span>
          <span class="rx-nav-popover__title">ENGINE NAVIGATION</span>
        </div>
        <span class="rx-nav-popover__tag">v{siteConfig.version}</span>
      </div>

      {
        isDocs && (
          <button
            type="button"
            class="rx-nav-popover__search-btn"
            id="rx-mobile-search-trigger"
            aria-label="Search documentation"
          >
            <Icon name="search" size={15} ariaHidden={true} />
            <span>Search docs...</span>
            <kbd class="rx-header__search-kbd">Ctrl K</kbd>
          </button>
        )
      }

      {/* Navigation Rows List */}
      <nav class="rx-nav-popover__nav" aria-label="Navigation Links">
        <ul class="rx-nav-popover__list" role="list">
          {navItems.map((item) => {
            const isActive = isItemActive(item.href, item.label);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={['rx-nav-row', item.accentClass, { 'is-active': isActive }]}
                >
                  <span class="rx-nav-row__icon-box">
                    <Icon name={item.icon} size={16} ariaHidden={true} />
                  </span>
                  <span class="rx-nav-row__info">
                    <span class="rx-nav-row__title">{item.label}</span>
                    <span class="rx-nav-row__desc">{item.desc}</span>
                  </span>
                  <span class="rx-nav-row__badge">{item.badge}</span>
                  <span class="rx-nav-row__arrow" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            );
          })}
          <li>
            <a
              href={siteConfig.repo}
              class="rx-nav-row rx-nav-row--github"
              target="_blank"
              rel="noreferrer noopener"
            >
              <span class="rx-nav-row__icon-box">
                <Icon name="github" size={16} ariaHidden={true} />
              </span>
              <span class="rx-nav-row__info">
                <span class="rx-nav-row__title">GitHub</span>
                <span class="rx-nav-row__desc">Source code, issues & releases</span>
              </span>
              <span class="rx-nav-row__badge">★ Star</span>
              <span class="rx-nav-row__arrow" aria-hidden="true">&#8599;</span>
            </a>
          </li>
        </ul>
      </nav>

      {
        isDocs && (
          <button
            type="button"
            class="rx-nav-popover__outline-btn"
            id="rx-mobile-outline-btn"
            aria-label="Browse documentation outline and sections"
          >
            <Icon name="book" size={16} ariaHidden={true} />
            <span>Browse Docs Outline</span>
            <span class="rx-nav-popover__arrow">&rarr;</span>
          </button>
        )
      }

      {/* Popover Footer Action */}
      {
        !isDocs && (
          <div class="rx-nav-popover__cta-wrap">
            <a href={withBase('/getting-started/')} class="rx-nav-popover__cta-btn">
              <span>Get started with REQNX</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        )
      }

      {/* Precision Telemetry Strip */}
      <div class="rx-nav-popover__telemetry">
        <span class="rx-nav-popover__telem-dot" aria-hidden="true"></span>
        <span>Node.js & Redis • P99.9 &lt; 15µs • Zero Deps</span>
      </div>
    </div>
  </div>
</header>

<style>
  @layer components {
    .rx-skip-link {
      position: absolute;
      top: -100px;
      left: 1rem;
      background: var(--rx-accent-indigo);
      color: #ffffff;
      padding: 0.5rem 1rem;
      border-radius: var(--rx-radius-sm);
      font-size: var(--rx-font-small);
      font-weight: 600;
      z-index: 1000;
      text-decoration: none;
      transition: top var(--rx-transition-fast);
    }

    .rx-skip-link:focus-visible {
      top: 1rem;
      outline: var(--rx-focus-ring);
    }

    .rx-sentinel {
      position: absolute;
      top: 0;
      left: 0;
      height: 1px;
      width: 1px;
      pointer-events: none;
      visibility: hidden;
    }

    .rx-header__progress {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--rx-accent-cyan);
      transform-origin: 0 50%;
      transform: scaleX(0);
      pointer-events: none;
      z-index: 101;
      display: none;
    }

    @supports (animation-timeline: scroll(root)) {
      @media (prefers-reduced-motion: no-preference) {
        html:not([data-motion="reduced"]) .rx-header__progress {
          display: block;
          animation: rx-scroll-progress linear;
          animation-timeline: scroll(root);
        }
      }
    }

    @keyframes rx-scroll-progress {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }

    .rx-header {
      position: sticky;
      top: 0;
      left: 0;
      right: 0;
      height: 64px;
      z-index: 100;
      background: transparent;
      border-bottom: 1px solid transparent;
      transition:
        background-color var(--rx-dur-base) var(--rx-ease-out),
        border-color var(--rx-dur-base) var(--rx-ease-out),
        backdrop-filter var(--rx-dur-base) var(--rx-ease-out);
    }

    @media (prefers-reduced-motion: reduce) {
      .rx-header {
        transition: none;
      }
    }
    html[data-motion="reduced"] .rx-header {
      transition: none;
    }

    .rx-header.is-docs,
    .rx-header.is-scrolled {
      background-color: color-mix(in srgb, var(--rx-surface-1) 85%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom-color: var(--rx-border);
    }

    .rx-header.is-docs .rx-header__inner {
      max-width: 1440px;
    }

    .rx-header__inner {
      max-width: 1280px;
      height: 100%;
      margin: 0 auto;
      padding: 0 clamp(1rem, 4vw, 2.5rem);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .rx-header__brand {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      flex-shrink: 0;
    }

    .rx-header__logo {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
      color: var(--rx-text-1);
    }

    .rx-header__logo:focus-visible {
      outline: var(--rx-focus-ring);
      border-radius: var(--rx-radius-xs);
    }

    .rx-header__wordmark {
      font-family: var(--rx-font-mono);
      font-size: 1.125rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--rx-text-1);
    }

    .rx-header__version {
      font-family: var(--rx-font-mono);
      font-size: 0.6875rem;
      font-weight: 600;
      padding: 0.125rem 0.375rem;
      border-radius: var(--rx-radius-xs);
      background: var(--rx-surface-3);
      color: var(--rx-text-2);
      border: 1px solid var(--rx-border-subtle);
    }

    @media (max-width: 480px) {
      .rx-header {
        height: 56px;
      }
      .rx-header__version {
        display: none;
      }
    }

    .rx-header__nav {
      display: none;
      position: relative;
    }

    @media (min-width: 768px) {
      .rx-header__nav {
        display: block;
      }
    }

    .rx-header__indicator {
      position: absolute;
      top: 50%;
      left: 0;
      transform: translateY(-50%);
      height: 32px;
      border-radius: var(--rx-radius-sm);
      background: var(--rx-surface-2);
      border: 1px solid var(--rx-border-subtle);
      pointer-events: none;
      opacity: 0;
      transition:
        transform var(--rx-dur-panel) var(--rx-ease-spring),
        opacity var(--rx-dur-fast) var(--rx-ease-out);
      z-index: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .rx-header__indicator {
        transition: none;
      }
    }
    html[data-motion="reduced"] .rx-header__indicator {
      transition: none;
    }

    .rx-header__nav-list {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .rx-header__nav-link {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.375rem 0.75rem;
      border-radius: var(--rx-radius-sm);
      font-size: var(--rx-font-small);
      font-weight: 500;
      color: var(--rx-text-2);
      text-decoration: none;
      background-color: transparent;
      transition: color var(--rx-dur-fast) var(--rx-ease-out);
    }

    .rx-header__nav-link:hover {
      color: var(--rx-text-1);
    }

    .rx-header__nav-link.is-active {
      color: var(--rx-text-1);
      font-weight: 600;
    }

    .rx-header__nav-link:focus-visible {
      outline: var(--rx-focus-ring);
    }

    .rx-header__actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .rx-header__search-btn {
      display: none;
      align-items: center;
      gap: 0.5rem;
      background: var(--rx-surface-2);
      border: 1px solid var(--rx-border);
      color: var(--rx-text-2);
      padding: 0.35rem 0.65rem;
      border-radius: var(--rx-radius-sm);
      font-family: var(--rx-font-mono);
      font-size: 0.75rem;
      cursor: pointer;
      min-height: 36px;
      min-width: 170px;
      justify-content: space-between;
      transition:
        background-color var(--rx-dur-fast) var(--rx-ease-out),
        border-color var(--rx-dur-fast) var(--rx-ease-out),
        color var(--rx-dur-fast) var(--rx-ease-out);
    }

    @media (min-width: 768px) {
      .rx-header__search-btn {
        display: inline-flex;
      }
    }

    .rx-header__search-btn:hover {
      background: var(--rx-surface-3);
      color: var(--rx-text-1);
      border-color: var(--rx-border-hover);
    }

    .rx-header__search-btn:focus-visible {
      outline: var(--rx-focus-ring);
    }

    .rx-header__search-label {
      flex: 1;
      text-align: left;
      margin-left: 0.15rem;
    }

    .rx-header__search-kbd {
      font-family: var(--rx-font-mono);
      font-size: 0.6875rem;
      padding: 0.1rem 0.35rem;
      border-radius: var(--rx-radius-xs);
      background: var(--rx-surface-3);
      border: 1px solid var(--rx-border-subtle);
      color: var(--rx-text-3);
      line-height: 1;
    }

    .rx-header__icon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      padding: 0;
      background: var(--rx-surface-2);
      border: 1px solid var(--rx-border);
      border-radius: var(--rx-radius-sm);
      color: var(--rx-text-2);
      cursor: pointer;
      transition:
        background-color var(--rx-dur-fast) var(--rx-ease-out),
        border-color var(--rx-dur-fast) var(--rx-ease-out),
        color var(--rx-dur-fast) var(--rx-ease-out);
    }

    @media (min-width: 768px) {
      .rx-header__icon-btn {
        display: none;
      }
    }

    .rx-header__icon-btn:hover {
      background: var(--rx-surface-3);
      color: var(--rx-text-1);
      border-color: var(--rx-border-hover);
    }

    .rx-header__icon-btn:focus-visible {
      outline: var(--rx-focus-ring);
    }

    .rx-header__cta {
      display: none;
    }

    @media (min-width: 640px) {
      .rx-header__cta {
        display: inline-flex;
      }
    }

    .rx-header__menu-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      padding: 0;
      border-radius: var(--rx-radius-sm);
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
      border: 1px solid rgba(255, 255, 255, 0.09);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
      color: var(--rx-text-2);
      cursor: pointer;
      transition:
        background-color var(--rx-dur-fast) var(--rx-ease-out),
        border-color var(--rx-dur-fast) var(--rx-ease-out),
        color var(--rx-dur-fast) var(--rx-ease-out),
        box-shadow var(--rx-dur-fast) var(--rx-ease-out),
        transform var(--rx-dur-instant) var(--rx-ease-out);
    }

    .rx-header__menu-btn:hover {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0.04) 100%);
      color: var(--rx-text-1);
      border-color: rgba(245, 158, 11, 0.4);
      box-shadow: 0 0 12px -2px rgba(245, 158, 11, 0.2);
    }

    .rx-header.menu-open .rx-header__menu-btn {
      background: rgba(245, 158, 11, 0.12);
      border-color: #fbbf24;
      color: #fbbf24;
      box-shadow: 0 0 14px -2px rgba(245, 158, 11, 0.3);
    }

    .rx-header__menu-btn:focus-visible {
      outline: 2px solid #fbbf24;
      outline-offset: 2px;
    }

    .rx-header__menu-icon-close {
      display: none;
    }

    .rx-header.menu-open .rx-header__menu-icon-open {
      display: none;
    }

    .rx-header.menu-open .rx-header__menu-icon-close {
      display: inline-block;
    }

    /* Floating Engineering Command Popover */
    .rx-mobile-sheet {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 99;
      pointer-events: none;
    }

    .rx-mobile-sheet.is-open {
      display: block;
      pointer-events: auto;
    }

    .rx-mobile-sheet__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      animation: rxFadeIn 180ms ease-out forwards;
    }

    @keyframes rxFadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .rx-nav-popover {
      position: fixed;
      top: 64px;
      right: clamp(0.75rem, 3vw, 2rem);
      width: min(390px, calc(100vw - 1.5rem));
      max-height: calc(100dvh - 80px);
      overflow-y: auto;
      background: rgba(13, 16, 23, 0.96);
      backdrop-filter: blur(28px) saturate(190%);
      -webkit-backdrop-filter: blur(28px) saturate(190%);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      box-shadow:
        0 24px 64px -16px rgba(0, 0, 0, 0.8),
        0 0 0 1px rgba(255, 255, 255, 0.05),
        0 0 36px -8px rgba(245, 158, 11, 0.14);
      padding: 1rem 1rem 1.15rem;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      animation: rxPopoverIn 200ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
      z-index: 100;
    }

    @keyframes rxPopoverIn {
      from {
        opacity: 0;
        transform: translateY(-8px) scale(0.97);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    /* Popover Header */
    .rx-nav-popover__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 0.25rem 0.65rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }

    .rx-nav-popover__status {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .rx-nav-popover__pulse-led {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #10b981;
      box-shadow: 0 0 8px rgba(16, 185, 129, 0.9);
      animation: rxLedPulse 2s ease-in-out infinite;
    }

    @keyframes rxLedPulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.85); }
    }

    .rx-nav-popover__title {
      font-family: var(--rx-font-mono);
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--rx-text-3);
    }

    .rx-nav-popover__tag {
      font-family: var(--rx-font-mono);
      font-size: 0.625rem;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.25);
      color: #fbbf24;
      font-weight: 550;
    }

    /* Search Button */
    .rx-nav-popover__search-btn {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      width: 100%;
      padding: 0.55rem 0.85rem;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 9px;
      color: var(--rx-text-3);
      font-family: var(--rx-font-sans);
      font-size: 0.8125rem;
      cursor: pointer;
      transition:
        background-color var(--rx-dur-fast) var(--rx-ease-out),
        border-color var(--rx-dur-fast) var(--rx-ease-out),
        color var(--rx-dur-fast) var(--rx-ease-out);
    }

    .rx-nav-popover__search-btn:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(245, 158, 11, 0.35);
