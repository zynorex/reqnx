---
import Section from './Section.astro';
import { landingCopy } from '../../copy/landing.copy';
import { withBase } from '../../site.config';
import Icon from '../common/Icon.astro';

const { whatItIs } = landingCopy;
---

<Section
  id="what-it-is"
  eyebrow={whatItIs.eyebrow}
  title={whatItIs.title}
  lede={whatItIs.lede}
>
  <!-- 1. The Decision Contract -->
  <div class="rx-contract-block">
    <div class="rx-contract-header">
      <h3 class="rx-contract-title">{whatItIs.theDecisionTitle}</h3>
      <p class="rx-contract-lede">{whatItIs.theDecisionLede}</p>
    </div>

    <div class="rx-contract-grid">
      {whatItIs.fields.map((f) => (
        <div class="rx-field-card">
          <div class="rx-field-top">
            <code class="rx-field-name">{f.name}</code>
            <span class="rx-field-type">{f.type}</span>
          </div>
          <p class="rx-field-desc">{f.description}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- 2. Why exact rate limiting is hard -->
  <div class="rx-challenges-block">
    <h3 class="rx-subheading">{whatItIs.whyHardTitle}</h3>
    <div class="rx-challenges-grid">
      {whatItIs.challenges.map((c) => (
        <div class="rx-challenge-card">
          <div class="rx-challenge-badge">
            <Icon name="diamond" size={14} ariaHidden={true} />
            <span>{c.title}</span>
          </div>
          <div class="rx-challenge-row">
            <span class="rx-challenge-label rx-label-problem">Problem</span>
            <p class="rx-challenge-text">{c.problem}</p>
          </div>
          <div class="rx-challenge-row">
            <span class="rx-challenge-label rx-label-solution">Solution</span>
            <p class="rx-challenge-text">{c.solution}</p>
          </div>
          <a href={`https://github.com/zynorex/reqnx/blob/main/${c.link}`} class="rx-challenge-link" target="_blank" rel="noopener noreferrer">
            <span>Read decision record</span>
            <Icon name="external" size={12} ariaHidden={true} />
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- 3. Who it's for -->
  <div class="rx-audience-block">
    <h3 class="rx-subheading">{whatItIs.whoItsForTitle}</h3>
    <ul class="rx-audience-list">
      {whatItIs.whoItsForPoints.map((point) => (
        <li class="rx-audience-item">
          <span class="rx-audience-icon" aria-hidden="true">
            <Icon name="check" size={14} ariaHidden={true} />
          </span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .rx-contract-block {
    background: var(--rx-surface-2);
    border: 1px solid var(--rx-border);
    border-radius: var(--rx-radius-md);
    padding: clamp(1.25rem, 3vw, 2rem);
    margin-bottom: 3.5rem;
  }

  .rx-contract-header {
    margin-bottom: 1.5rem;
  }

  .rx-contract-title {
    font-size: var(--rx-font-h3);
    margin-bottom: 0.25rem;
  }

  .rx-contract-lede {
    font-size: 0.9375rem;
    color: var(--rx-text-3);
    margin: 0;
  }

  .rx-contract-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1rem;
  }

  .rx-field-card {
    background: var(--rx-surface-1);
    border: 1px solid var(--rx-border-subtle);
    border-radius: var(--rx-radius-sm);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .rx-field-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .rx-field-name {
    color: var(--rx-accent-cyan);
    font-family: var(--rx-font-mono);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .rx-field-type {
    font-family: var(--rx-font-mono);
    font-size: 0.75rem;
    color: var(--rx-text-2);
    background: var(--rx-surface-3);
    padding: 0.125rem 0.375rem;
    border-radius: var(--rx-radius-xs);
  }

  .rx-field-desc {
    font-size: 0.8125rem;
    color: var(--rx-text-2);
    margin: 0;
    line-height: 1.45;
  }

  /* Challenges */
  .rx-challenges-block {
    margin-bottom: 3.5rem;
  }

  .rx-subheading {
    font-size: var(--rx-font-h3);
    margin-bottom: 1.5rem;
  }

  .rx-challenges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .rx-challenge-card {
    background: var(--rx-surface-2);
    border: 1px solid var(--rx-border);
    border-radius: var(--rx-radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rx-challenge-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--rx-font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--rx-text-1);
  }

  .rx-challenge-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .rx-challenge-label {
    font-family: var(--rx-font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .rx-label-problem {
    color: var(--rx-semantic-denied);
  }

  .rx-label-solution {
    color: var(--rx-semantic-allowed);
  }

  .rx-challenge-text {
    font-size: 0.875rem;
    color: var(--rx-text-2);
    margin: 0;
    line-height: 1.5;
  }

  .rx-challenge-link {
    margin-top: auto;
    font-family: var(--rx-font-mono);
    font-size: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--rx-text-3);
  }

  .rx-challenge-link:hover {
    color: var(--rx-accent-cyan);
  }

  /* Audience */
  .rx-audience-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .rx-audience-item {
    background: var(--rx-surface-2);
    border: 1px solid var(--rx-border-subtle);
    border-radius: var(--rx-radius-sm);
    padding: 1rem;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--rx-text-2);
    line-height: 1.5;
  }

  .rx-audience-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--rx-semantic-allowed-surface);
    color: var(--rx-semantic-allowed);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
</style>
