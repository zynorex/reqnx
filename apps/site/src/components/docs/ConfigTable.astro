---
/**
 * ConfigTable.astro
 * Type-safe configuration option tables with defaults and constraints.
 */
interface ConfigItem {
  name: string;
  type: string;
  defaultVal?: string;
  constraints?: string;
  description: string;
}

interface Props {
  title?: string;
  items: ConfigItem[];
}

const { title = 'Configuration Options', items } = Astro.props;
---

<div class="rx-config-table-wrap rx-breakout">
  {title && <div class="rx-table-header-title">{title}</div>}
  <table class="rx-config-table">
    <thead>
      <tr>
        <th>Option</th>
        <th>Type</th>
        <th>Default</th>
        <th>Constraints</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {
        items.map((item) => (
          <tr>
            <td>
              <code class="rx-param-name">{item.name}</code>
            </td>
            <td>
              <span class="rx-param-type">{item.type}</span>
            </td>
            <td>
              <code class="rx-param-def">{item.defaultVal ?? '—'}</code>
            </td>
            <td class="rx-param-constraints">{item.constraints ?? '—'}</td>
            <td class="rx-param-desc">{item.description}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .rx-config-table-wrap {
    margin: 1.5rem 0 2rem 0;
    overflow-x: auto;
  }

  .rx-table-header-title {
    font-family: var(--rx-font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--rx-text-3);
    margin-bottom: 0.5rem;
  }

  .rx-config-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--rx-radius-md);
    background: var(--rx-surface-2);
    font-size: 0.875rem;
    overflow: hidden;
  }

  th {
    background: var(--rx-surface-3);
    color: var(--rx-text-1);
    font-family: var(--rx-font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    text-align: left;
  }

  td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--sl-color-hairline-light);
    color: var(--rx-text-2);
    vertical-align: top;
  }

  tr:last-child td {
    border-bottom: none;
  }

  .rx-param-name {
    font-family: var(--rx-font-mono);
    font-weight: 600;
    color: var(--rx-text-1);
    font-size: 0.8125rem;
    background: transparent;
    padding: 0;
    border: none;
  }

  .rx-param-type {
    font-family: var(--rx-font-mono);
    font-size: 0.75rem;
    color: var(--rx-accent-indigo);
    background: var(--sl-color-accent-low);
    padding: 0.15rem 0.45rem;
    border-radius: var(--rx-radius-xs);
    display: inline-block;
  }

  .rx-param-def {
    font-family: var(--rx-font-mono);
    font-size: 0.8125rem;
    color: var(--rx-text-3);
  }

  .rx-param-constraints {
    font-size: 0.8125rem;
    color: var(--rx-text-3);
    font-family: var(--rx-font-mono);
  }

  .rx-param-desc {
    line-height: 1.5;
  }
</style>
