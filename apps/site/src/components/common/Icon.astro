---
/**
 * Custom inline SVG icon component on a 24px grid with 1.5px stroke.
 * Never relies on third-party icon fonts or packages.
 */
interface Props {
  name:
    | 'check'
    | 'cross'
    | 'diamond'
    | 'half-circle'
    | 'dashed-circle'
    | 'terminal'
    | 'github'
    | 'copy'
    | 'external'
    | 'play'
    | 'pause'
    | 'sun'
    | 'moon'
    | 'monitor'
    | 'arrow-right';
  size?: number;
  class?: string;
  ariaHidden?: boolean;
}

const { name, size = 16, class: className = '', ariaHidden = true } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`rx-icon ${className}`}
  aria-hidden={ariaHidden ? 'true' : 'false'}
>
  {name === 'check' && (
    <polyline points="20 6 9 17 4 12" />
  )}
  {name === 'cross' && (
    <>
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </>
  )}
  {name === 'diamond' && (
    <polygon points="12 2 22 12 12 22 2 12 12 2" />
  )}
  {name === 'half-circle' && (
    <>
      <circle cx="12" cy="12" r="10" />
      <path d="M12 2 A 10 10 0 0 1 12 22 Z" fill="currentColor" />
    </>
  )}
  {name === 'dashed-circle' && (
    <circle cx="12" cy="12" r="9" stroke-dasharray="3 3" />
  )}
  {name === 'terminal' && (
    <>
      <polyline points="4 17 10 11 4 5" />
      <line x1="12" y1="19" x2="20" y2="19" />
    </>
  )}
  {name === 'github' && (
    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
  )}
  {name === 'copy' && (
    <>
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
    </>
  )}
  {name === 'external' && (
    <>
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
      <polyline points="15 3 21 3 21 9" />
      <line x1="10" y1="14" x2="21" y2="3" />
    </>
  )}
  {name === 'play' && (
    <polygon points="5 3 19 12 5 21 5 3" fill="currentColor" />
  )}
  {name === 'pause' && (
    <>
      <rect x="6" y="4" width="4" height="16" fill="currentColor" />
      <rect x="14" y="4" width="4" height="16" fill="currentColor" />
    </>
  )}
  {name === 'sun' && (
    <>
      <circle cx="12" cy="12" r="5" />
      <line x1="12" y1="1" x2="12" y2="3" />
      <line x1="12" y1="21" x2="12" y2="23" />
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
      <line x1="1" y1="12" x2="3" y2="12" />
      <line x1="21" y1="12" x2="23" y2="12" />
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
    </>
  )}
  {name === 'moon' && (
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  )}
  {name === 'monitor' && (
    <>
      <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
      <line x1="8" y1="21" x2="16" y2="21" />
      <line x1="12" y1="17" x2="12" y2="21" />
    </>
  )}
  {name === 'arrow-right' && (
    <>
      <line x1="5" y1="12" x2="19" y2="12" />
      <polyline points="12 5 19 12 12 19" />
    </>
  )}
</svg>

<style>
  .rx-icon {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }
</style>
