---
// ──────────────────────────────────────────────────────────────────────────────
// apps/site/src/components/chrome/MobileSheet.astro
//
// Native <dialog> Modal Sheet Drawer for mobile navigation (< 1024px).
// ──────────────────────────────────────────────────────────────────────────────

import Logo from '../brand/Logo.astro';
import { chromeData } from '../../data/chrome';
import { withBase } from '../../site.config';
import { ThemeControl } from './ThemeControl';
import MotionControl from '../common/MotionControl.astro';
import Button from '../common/Button.astro';

interface Props {
  variant?: 'marketing' | 'docs';
}

const { variant = 'marketing' } = Astro.props;
---

<!-- Scrim Backdrop -->
<div class="rx-mobile-sheet-backdrop" id="rx-mobile-backdrop" aria-hidden="true"></div>

<!-- Native Modal Sheet Dialog -->
<dialog
  class="rx-mobile-sheet-dialog"
  id="rx-mobile-sheet"
  aria-labelledby="rx-mobile-sheet-title"
>
  <!-- 56px Header Row -->
  <div class="rx-sheet-header">
    <div id="rx-mobile-sheet-title">
      <Logo size={24} showText={true} />
    </div>
    <button
      type="button"
      class="rx-sheet-close-btn"
      id="rx-mobile-sheet-close"
      aria-label="Close navigation menu"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="rx-sheet-content">
    <!-- Full-width 44px Search Trigger -->
    <button
      type="button"
      class="rx-sheet-search-trigger"
      id="rx-sheet-search-trigger"
      aria-label="Search documentation"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <span>Search documentation...</span>
    </button>

    <!-- Navigation Rows (48px targets) -->
    <nav class="rx-sheet-nav" aria-label="Mobile Navigation">
      <ul class="rx-sheet-nav-list" role="list">
        {
          variant === 'marketing' ? (
            <>
              <li>
                <a href={withBase('/getting-started/')} class="rx-sheet-nav-row">
                  <span>Docs</span>
                  <span class="rx-sheet-row-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </li>
              <li>
                <!-- Algorithms Inline Accordion -->
                <div class="rx-sheet-accordion">
                  <button
                    type="button"
                    class="rx-sheet-accordion-btn"
                    id="rx-sheet-algo-acc-btn"
                    aria-expanded="false"
                    aria-controls="rx-sheet-algo-panel"
                  >
                    <span>Algorithms</span>
                    <svg class="rx-sheet-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </button>
                  <div class="rx-sheet-accordion-content" id="rx-sheet-algo-panel" style="display: none;">
                    {chromeData.flyoutAlgorithms.map((algo) => (
                      <a href={algo.href} class="rx-sheet-accordion-link">
                        <span>{algo.name}</span>
                        {algo.status === 'available' && <span class="rx-status-mini-chip rx-status-mini-chip--available">Available</span>}
                      </a>
                    ))}
                    <a href={withBase('/algorithms/')} class="rx-sheet-accordion-compare">
                      Compare all algorithms &rarr;
                    </a>
                  </div>
                </div>
              </li>
              <li>
                <a href={withBase('/playground/')} class="rx-sheet-nav-row">
                  <span>Playground</span>
                  <span class="rx-sheet-row-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </li>
              <li>
                <a href="#status" class="rx-sheet-nav-row">
                  <span>Status</span>
                  <span class="rx-sheet-row-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            </>
          ) : (
            // Docs Navigation Areas
            chromeData.docsAreas.map((area) => (
              <li>
                <a href={area.href} class="rx-sheet-nav-row">
                  <span>{area.label}</span>
                  <span class="rx-sheet-row-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))
          )
        }

        <li>
          <a
            href={chromeData.brand.repo}
            target="_blank"
            rel="noreferrer"
            class="rx-sheet-nav-row"
          >
            <span>GitHub</span>
            <span class="rx-sheet-row-arrow" aria-hidden="true">&#8599;</span>
          </a>
        </li>
      </ul>
    </nav>

    {/* CTA for marketing variant */}
    {
      variant === 'marketing' && (
        <div class="rx-sheet-cta-wrap">
          <Button href={withBase('/getting-started/')} variant="primary" size="md" block={true}>
            Get started
          </Button>
        </div>
      )
    }

    <!-- Preferences Group (Theme & Motion) -->
    <div class="rx-sheet-pref-group">
      <div class="rx-sheet-pref-item">
        <span class="rx-sheet-pref-label">Theme</span>
        <ThemeControl client:load idPrefix="rx-theme-mobile" />
      </div>
      <div class="rx-sheet-pref-item">
        <span class="rx-sheet-pref-label">Motion</span>
        <MotionControl />
      </div>
    </div>
  </div>
</dialog>

<style>
  .rx-mobile-sheet-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: calc(var(--z-sheet, 60) - 1);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--rx-dur-base) var(--rx-ease-out);
  }

  .rx-mobile-sheet-backdrop.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .rx-mobile-sheet-dialog {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(88vw, 360px);
    height: 100dvh;
    max-height: 100dvh;
    background: var(--rx-surface-2);
    border: none;
    border-right: 1px solid var(--rx-header-border, rgba(255, 255, 255, 0.08));
    z-index: var(--z-sheet, 60);
    display: flex;
    flex-direction: column;
    box-shadow: 16px 0 32px rgba(0, 0, 0, 0.45);
    transform: translateX(-100%);
    transition: transform var(--rx-dur-spring) var(--rx-ease-spring);
    overflow-y: auto;
    padding: 0;
  }

  .rx-mobile-sheet-dialog.is-open {
    transform: translateX(0);
  }

  .rx-sheet-header {
    height: 56px;
    padding: 0 1.25rem;
    border-bottom: 1px solid var(--rx-border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }

  .rx-sheet-close-btn {
    height: 36px;
    width: 36px;
    border-radius: var(--rx-radius-sm);
    background: transparent;
    border: 1px solid transparent;
    color: var(--rx-text-2);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .rx-sheet-close-btn:hover {
    background: var(--rx-surface-3);
    color: var(--rx-text-1);
    border-color: var(--rx-border-subtle);
  }

  .rx-sheet-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex: 1;
  }

  .rx-sheet-search-trigger {
    width: 100%;
    height: 44px;
    background: var(--rx-surface-3);
    border: 1px solid var(--rx-border-subtle);
    border-radius: var(--rx-radius-md);
    color: var(--rx-text-3);
    display: flex;
    align-items: center;
    padding: 0 0.85rem;
    gap: 0.625rem;
    font-size: 0.875rem;
    cursor: pointer;
    text-align: left;
    transition: border-color var(--rx-dur-fast);
  }

  .rx-sheet-search-trigger:hover,
  .rx-sheet-search-trigger:focus-visible {
    border-color: var(--rx-accent-cyan);
    color: var(--rx-text-1);
  }

  .rx-sheet-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
  }

  .rx-sheet-nav-row {
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.85rem;
    border-radius: var(--rx-radius-sm);
    color: var(--rx-text-1);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    background: var(--rx-surface-1);
    border: 1px solid var(--rx-border-subtle);
    transition: all var(--rx-dur-fast);
  }

  .rx-sheet-nav-row:hover {
    background: var(--rx-surface-3);
    border-color: var(--rx-border-hover);
  }

  .rx-sheet-row-arrow {
    color: var(--rx-text-3);
  }

  /* Accordion */
  .rx-sheet-accordion {
    background: var(--rx-surface-1);
    border: 1px solid var(--rx-border-subtle);
    border-radius: var(--rx-radius-sm);
    overflow: hidden;
  }

  .rx-sheet-accordion-btn {
    width: 100%;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.85rem;
    background: transparent;
    border: none;
    color: var(--rx-text-1);
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
  }

  .rx-sheet-chevron {
    transition: transform var(--rx-dur-fast) var(--rx-ease-out);
  }

  .rx-sheet-accordion-btn[aria-expanded='true'] .rx-sheet-chevron {
    transform: rotate(180deg);
  }

  .rx-sheet-accordion-content {
    padding: 0.5rem 0.85rem 0.75rem;
    border-top: 1px solid var(--rx-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .rx-sheet-accordion-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--rx-text-2);
    text-decoration: none;
    font-size: 0.875rem;
    padding: 0.25rem 0;
  }

  .rx-sheet-accordion-link:hover {
    color: var(--rx-text-1);
  }

  .rx-sheet-accordion-compare {
    color: var(--rx-accent-cyan);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
    margin-top: 0.25rem;
  }

  .rx-sheet-cta-wrap {
    margin-top: 0.5rem;
  }

  .rx-sheet-pref-group {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--rx-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .rx-sheet-pref-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .rx-sheet-pref-label {
    font-family: var(--rx-font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--rx-text-3);
  }

  .rx-status-mini-chip {
    font-family: var(--rx-font-mono);
    font-size: 0.625rem;
    padding: 0.1rem 0.4rem;
    border-radius: var(--rx-radius-full);
    text-transform: uppercase;
  }

  .rx-status-mini-chip--available {
    background: var(--rx-semantic-allowed-surface);
    color: var(--rx-semantic-allowed);
    border: 1px solid rgba(16, 185, 129, 0.25);
  }
</style>

<script>
  const sheet = document.getElementById('rx-mobile-sheet') as HTMLDialogElement | null;
  const backdrop = document.getElementById('rx-mobile-backdrop');
  const closeBtn = document.getElementById('rx-mobile-sheet-close');
  const algoBtn = document.getElementById('rx-sheet-algo-acc-btn');
  const algoPanel = document.getElementById('rx-sheet-algo-panel');
  const searchTrigger = document.getElementById('rx-sheet-search-trigger');

  let lastActiveElement: HTMLElement | null = null;

  function openSheet() {
    if (!sheet) return;
    lastActiveElement = document.activeElement as HTMLElement;

    backdrop?.classList.add('is-visible');
    sheet.classList.add('is-open');
    if (typeof sheet.showModal === 'function') {
      try {
        sheet.showModal();
      } catch {}
    }
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeSheet() {
    if (!sheet) return;
    sheet.classList.remove('is-open');
    backdrop?.classList.remove('is-visible');
    if (typeof sheet.close === 'function') {
      try {
        sheet.close();
      } catch {}
    }
    document.body.style.overflow = '';
    lastActiveElement?.focus();
  }

  // Event bus integration
  window.addEventListener('rx-open-mobile-sheet', openSheet);
  closeBtn?.addEventListener('click', closeSheet);
  backdrop?.addEventListener('click', closeSheet);

  sheet?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeSheet();
    }
  });

  // Accordion toggle
  algoBtn?.addEventListener('click', () => {
    if (!algoPanel) return;
    const isExpanded = algoBtn.getAttribute('aria-expanded') === 'true';
    algoBtn.setAttribute('aria-expanded', String(!isExpanded));
    algoPanel.style.display = isExpanded ? 'none' : 'flex';
  });

  // Search trigger wiring in sheet
  searchTrigger?.addEventListener('click', () => {
    closeSheet();
    // Dispatch search open event
    window.dispatchEvent(new CustomEvent('rx-open-search'));
  });

  // Automatically close sheet if viewport expands past 1024px
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches && sheet?.classList.contains('is-open')) {
      closeSheet();
    }
  });
</script>
