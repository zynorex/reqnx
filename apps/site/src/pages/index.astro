---
import { siteConfig, withBase } from '../site.config';
import Header from '../components/landing/Header.astro';
import HeroV3 from '../components/landing-v3/HeroV3.astro';
import ArchitectureStage from '../components/landing-v3/ArchitectureStage.astro';
import ProofBand from '../components/landing-v3/ProofBand.astro';
import ContrastSection from '../components/landing-v3/ContrastSection.astro';
import TiersSection from '../components/landing-v3/TiersSection.astro';
import BenefitsTerminal from '../components/landing-v3/BenefitsTerminal.astro';
import StatusMatrix from '../components/landing-v3/StatusMatrix.astro';
import TechnicalFaq from '../components/landing-v3/TechnicalFaq.astro';
import ClosingBand from '../components/landing-v3/ClosingBand.astro';
import Footer from '../components/landing/Footer.astro';
import BrandIcons from '../components/brand/BrandIcons.astro';
import '../styles/global.css';
import '../styles/landing.css';
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <style is:inline>
      @layer reset, tokens, base, layout, components, utilities;
    </style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{siteConfig.name} — Rate limiting you can reason about</title>
    <meta name="description" content={siteConfig.description} />
    <meta name="robots" content="noindex, nofollow" />

    <BrandIcons />

    <!-- Typography: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    />

    <!-- Theme, Motion & Lite Mode Initialization Script (prevents flash and layout shifts) -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('rx-theme') || 'system';
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const isDark = stored === 'dark' || (stored === 'system' && prefersDark);
          document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');

          const storedMotion = localStorage.getItem('rx-motion');
          const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const isSaveData = Boolean(navigator.connection && navigator.connection.saveData);
          const isLowEnd = Boolean(
            (navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 4) ||
            (navigator.deviceMemory && navigator.deviceMemory < 4)
          );
          if (isSaveData || isLowEnd) {
            document.documentElement.dataset.liteMode = 'true';
          }
          if (storedMotion === 'reduced' || prefersReduced || isSaveData || isLowEnd) {
            document.documentElement.dataset.motion = 'reduced';
          } else {
            document.documentElement.dataset.motion = 'full';
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
          document.documentElement.dataset.motion = 'full';
        }
      })();
    </script>
  </head>
  <body>
    <Header currentPath={withBase('/')} />

    <main id="main-content">
      <HeroV3 />
      <ArchitectureStage />
      <ProofBand />
      <ContrastSection />
      <TiersSection />
      <BenefitsTerminal />
      <StatusMatrix />
      <TechnicalFaq />
      <ClosingBand />
    </main>

    <Footer />
  </body>
</html>
