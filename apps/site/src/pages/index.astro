---
import { siteConfig, withBase } from '../site.config';
import Header from '../components/landing/Header.astro';
import Hero from '../components/landing/Hero.astro';
import WhatItIs from '../components/landing/WhatItIs.astro';
import WhyChoose from '../components/landing/WhyChoose.astro';
import TheSeam from '../components/landing/TheSeam.astro';
import AlgorithmTabs from '../components/landing/AlgorithmTabs.astro';
import Quickstart from '../components/landing/Quickstart.astro';
import Recipes from '../components/landing/Recipes.astro';
import Architecture from '../components/landing/Architecture.astro';
import StatusSection from '../components/landing/StatusSection.astro';
import FaqSection from '../components/landing/FaqSection.astro';
import OpenSourceSection from '../components/landing/OpenSourceSection.astro';
import FinalCta from '../components/landing/FinalCta.astro';
import Footer from '../components/landing/Footer.astro';
import BrandIcons from '../components/brand/BrandIcons.astro';
import '../styles/global.css';
import '../styles/landing.css';
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteConfig.name} — Rate limiting you can reason about</title>
    <meta name="description" content={siteConfig.description} />
    <meta name="robots" content="noindex, nofollow" />

    <BrandIcons />

    <!-- Typography: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    />

    <!-- Theme Initialization Script (prevents theme flash) -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('rx-theme') || 'system';
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const isDark = stored === 'dark' || (stored === 'system' && prefersDark);
          document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <Header currentPath={withBase('/')} />

    <main id="main-content">
      <Hero />
      <WhatItIs />
      <WhyChoose />
      <TheSeam />
      <AlgorithmTabs />
      <Quickstart />
      <Recipes />
      <Architecture />
      <StatusSection />
      <FaqSection />
      <OpenSourceSection />
      <FinalCta />
    </main>

    <Footer />
  </body>
</html>
