---
// ──────────────────────────────────────────────────────────────────────────────
// apps/site/src/pages/dev/styleguide/mobile/[...slug].astro
//
// Mobile Design System & Primitives Styleguide (Dev Only)
// Zero output in production builds (getStaticPaths returns []).
// ──────────────────────────────────────────────────────────────────────────────

import Button from '../../../../components/common/Button.astro';
import StatusChip from '../../../../components/common/StatusChip.astro';
import Dock from '../../../../components/chrome/Dock.astro';
import Rail from '../../../../components/common/Rail.astro';
import StickyAction from '../../../../components/common/StickyAction.astro';
import '../../../../styles/global.css';

export function getStaticPaths() {
  if (import.meta.env.PROD && !process.env.BUILD_DEV_STYLEGUIDE) {
    return [];
  }
  return [{ params: { slug: undefined } }];
}
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>REQNX — Mobile Primitives Styleguide (Dev Only)</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    />
    <style>
      .sg-container {
        padding: 1.5rem 1rem calc(var(--rx-dock-total-height, 56px) + 2rem);
        max-width: 640px;
        margin: 0 auto;
        box-sizing: border-box;
      }
      .sg-header {
        margin-bottom: 2.5rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--rx-border-subtle);
      }
      .sg-badge {
        font-family: var(--rx-font-mono);
        font-size: 0.75rem;
        color: var(--rx-accent-cyan);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }
      .sg-title {
        font-size: 1.625rem;
        margin: 0.25rem 0;
        font-family: var(--rx-font-mono);
      }
      .sg-section {
        margin-bottom: 3rem;
      }
      .sg-section-title {
        font-family: var(--rx-font-mono);
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--rx-text-1);
        margin: 0 0 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--rx-border-subtle);
      }
      .sg-card {
        background: var(--rx-surface-2);
        border: 1px solid var(--rx-border-subtle);
        border-radius: var(--rx-radius-md);
        padding: 1.25rem;
        margin-bottom: 1rem;
      }
      .sg-target-box {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        min-height: 44px;
        border: 1px dashed var(--rx-accent-indigo);
        background: rgba(79, 70, 229, 0.08);
        border-radius: var(--rx-radius-sm);
        padding: 0.5rem;
        box-sizing: border-box;
        font-family: var(--rx-font-mono);
        font-size: 0.75rem;
        color: var(--rx-accent-indigo);
      }
      .sg-target-grid {
        display: flex;
        align-items: center;
        gap: 8px; /* 8px minimum touch spacing */
        flex-wrap: wrap;
      }
      .sg-code-bleed {
        margin-left: -1rem;
        margin-right: -1rem;
        padding: 1rem;
        background: var(--rx-terminal-bg, #07090e);
        border-top: 1px solid var(--rx-hairline, rgba(255, 255, 255, 0.1));
        border-bottom: 1px solid var(--rx-hairline, rgba(255, 255, 255, 0.1));
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        font-family: var(--rx-font-mono);
        font-size: 0.8125rem;
        color: var(--rx-terminal-fg, #f8fafc);
        line-height: 1.5;
      }
    </style>
  </head>
  <body>
    <main class="sg-container">
      <header class="sg-header">
        <span class="sg-badge">Design Specimen</span>
        <h1 class="sg-title">Mobile Primitives Styleguide</h1>
        <p style="color: var(--rx-text-2); font-size: 0.875rem; margin: 0.25rem 0 0;">
          Formal specification for 320–767px mobile viewports: touch targets, typography scales, tactile pressed states, and thumb zone primitives.
        </p>
      </header>

      <!-- 1. Touch Targets & Spacing Guarantee -->
      <section class="sg-section" aria-labelledby="sg-touch-title">
        <h2 class="sg-section-title" id="sg-touch-title">
          1. Touch Targets (≥ 44×44px, ≥ 8px Spacing)
        </h2>
        <div class="sg-card">
          <p style="color: var(--rx-text-2); font-size: 0.8125rem; margin: 0 0 1rem;">
            Dashed indigo boundaries illustrate the exact 44×44px touch bounding boxes with mandatory 8px margins between adjacent targets:
          </p>
          <div class="sg-target-grid">
            <div class="sg-target-box">44×44</div>
            <div class="sg-target-box">44×44</div>
            <div class="sg-target-box">44×44</div>
            <div class="sg-target-box">44×44</div>
          </div>
        </div>
      </section>

      <!-- 2. Mobile Typography Hierarchy -->
      <section class="sg-section" aria-labelledby="sg-type-title">
        <h2 class="sg-section-title" id="sg-type-title">
          2. Mobile Typography Scale & Line Lengths
        </h2>
        <div class="sg-card" style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div>
            <div style="font-family: var(--rx-font-mono); font-size: 0.6875rem; color: var(--rx-text-3); text-transform: uppercase;">Display H1 (clamp 2.25rem – 2.75rem)</div>
            <h1 style="font-size: clamp(2.25rem, 7vw, 2.75rem); margin: 0.25rem 0 0; line-height: 1.15; letter-spacing: -0.03em;">
              Predictable rate limiting.
            </h1>
          </div>

          <div>
            <div style="font-family: var(--rx-font-mono); font-size: 0.6875rem; color: var(--rx-text-3); text-transform: uppercase;">Section H2 (clamp 1.5rem – 1.85rem)</div>
            <h2 style="font-size: clamp(1.5rem, 5vw, 1.85rem); margin: 0.25rem 0 0; line-height: 1.25;">
              Built for high concurrency
            </h2>
          </div>

          <div>
            <div style="font-family: var(--rx-font-mono); font-size: 0.6875rem; color: var(--rx-text-3); text-transform: uppercase;">Lede Prose (1.05rem, ~38ch measure)</div>
            <p style="font-size: 1.05rem; color: var(--rx-text-2); margin: 0.25rem 0 0; line-height: 1.55; max-width: 42ch;">
              Sub-millisecond decisions with atomic Redis counters and zero state drift.
            </p>
          </div>

          <div>
            <div style="font-family: var(--rx-font-mono); font-size: 0.6875rem; color: var(--rx-text-3); text-transform: uppercase;">Docs Reading Prose (17px / 1.6)</div>
            <p style="font-size: 1.0625rem; color: var(--rx-text-2); margin: 0.25rem 0 0; line-height: 1.6; max-width: 44ch;">
              When requests arrive faster than the bucket capacity, excess tokens are refused immediately without waiting for Redis locks.
            </p>
          </div>
        </div>
      </section>

      <!-- 3. Mobile Buttons & Pressed States -->
      <section class="sg-section" aria-labelledby="sg-buttons-title">
        <h2 class="sg-section-title" id="sg-buttons-title">
          3. Mobile Buttons & Instant Press Feedback (&le; 90ms)
        </h2>
        <div class="sg-card" style="display: flex; flex-direction: column; gap: 1rem;">
          <div>
            <div style="font-family: var(--rx-font-mono); font-size: 0.6875rem; color: var(--rx-text-3); margin-bottom: 0.5rem;">PRIMARY 48PX CTA (FULL WIDTH)</div>
            <Button variant="primary" size="lg" style="width: 100%;">
              Get Started with REQNX
            </Button>
          </div>

          <div>
            <div style="font-family: var(--rx-font-mono); font-size: 0.6875rem; color: var(--rx-text-3); margin-bottom: 0.5rem;">SECONDARY 48PX ACTION</div>
            <Button variant="secondary" size="lg" style="width: 100%;">
              Explore Interactive Simulator
            </Button>
          </div>

          <div>
            <div style="font-family: var(--rx-font-mono); font-size: 0.6875rem; color: var(--rx-text-3); margin-bottom: 0.5rem;">DUAL 40PX THUMB PILLS</div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
              <Button variant="secondary" size="md">Send one</Button>
              <Button variant="primary" size="md">Send burst</Button>
            </div>
          </div>
        </div>
      </section>

      <!-- 4. Full-Bleed Code Block Primitive -->
      <section class="sg-section" aria-labelledby="sg-code-title">
        <h2 class="sg-section-title" id="sg-code-title">
          4. Full-Bleed Code Block (Mobile Edge Breakout)
        </h2>
        <div class="sg-code-bleed">
<pre style="margin: 0;"><code><span style="color: #818cf8;">import</span> &#123; createLimiter &#125; <span style="color: #818cf8;">from</span> <span style="color: #34d399;">'@reqnx/redis'</span>;

<span style="color: #818cf8;">const</span> limiter = <span style="color: #14ddfd;">createLimiter</span>(&#123;
  algorithm: <span style="color: #34d399;">'token-bucket'</span>,
  capacity: <span style="color: #fbbf24;">100</span>,
  refillRate: <span style="color: #fbbf24;">10</span>,
&#125;);

<span style="color: #818cf8;">const</span> decision = <span style="color: #818cf8;">await</span> limiter.<span style="color: #14ddfd;">check</span>(<span style="color: #34d399;">'user-1024'</span>);
console.log(decision.allowed); <span style="color: #94a3b8;">// true</span></code></pre>
        </div>
      </section>

      <!-- 5. Rail Primitive Specimen -->
      <section class="sg-section" aria-labelledby="sg-rail-title">
        <h2 class="sg-section-title" id="sg-rail-title">
          5. Rail Primitive (Scroll-Snap & Peeking)
        </h2>
        <Rail ariaLabel="Mobile Primitives Showcase" peek={true}>
          <div class="sg-card" style="width: 280px; margin: 0;">
            <span class="sg-badge">Card 1</span>
            <h3 style="font-family: var(--rx-font-mono); font-size: 1rem; margin: 0.5rem 0;">Scroll Snap Cell</h3>
            <p style="color: var(--rx-text-2); font-size: 0.8125rem; margin: 0;">Snap align start with momentum physics.</p>
          </div>
          <div class="sg-card" style="width: 280px; margin: 0;">
            <span class="sg-badge">Card 2</span>
            <h3 style="font-family: var(--rx-font-mono); font-size: 1rem; margin: 0.5rem 0;">Peek Dimension</h3>
            <p style="color: var(--rx-text-2); font-size: 0.8125rem; margin: 0;">Subsequent card visibly peeks 16%.</p>
          </div>
          <div class="sg-card" style="width: 280px; margin: 0;">
            <span class="sg-badge">Card 3</span>
            <h3 style="font-family: var(--rx-font-mono); font-size: 1rem; margin: 0.5rem 0;">Step Buttons</h3>
            <p style="color: var(--rx-text-2); font-size: 0.8125rem; margin: 0;">Accessible for non-touch cursor users.</p>
          </div>
        </Rail>
      </section>
    </main>

    <!-- Bottom Thumb Dock -->
    <Dock currentPath="/dev/styleguide/mobile" />
  </body>
</html>
