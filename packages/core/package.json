{
  "name": "@reqnx/core",
  "version": "0.0.0",
  "description": "Pluggable, distributed-ready rate limiter — core types, pure algorithms, MemoryStore",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check-package": "publint && attw --pack ."
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
