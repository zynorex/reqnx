{
  "name": "@reqnx/redis",
  "version": "0.0.0",
  "description": "Redis store for @reqnx/core — Lua-based atomic rate limiting",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node-redis": {
      "import": {
        "types": "./dist/adapters/node-redis.d.ts",
        "default": "./dist/adapters/node-redis.js"
      },
      "require": {
        "types": "./dist/adapters/node-redis.d.cts",
        "default": "./dist/adapters/node-redis.cjs"
      }
    },
    "./ioredis": {
      "import": {
        "types": "./dist/adapters/ioredis.d.ts",
        "default": "./dist/adapters/ioredis.js"
      },
      "require": {
        "types": "./dist/adapters/ioredis.d.cts",
        "default": "./dist/adapters/ioredis.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "node-redis.js",
    "node-redis.cjs",
    "node-redis.d.ts",
    "ioredis.js",
    "ioredis.cjs",
    "ioredis.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "tsx scripts/build-lua.ts",
    "build": "tsdown src/index.ts src/adapters/node-redis.ts src/adapters/ioredis.ts --format esm,cjs --dts",
    "build:lua": "tsx scripts/build-lua.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check-package": "publint && attw --pack ."
  },
  "dependencies": {
    "@reqnx/core": "workspace:*"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0",
    "redis": "^4.7.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@reqnx/testkit": "workspace:*",
    "@types/node": "^22.0.0",
    "ioredis": "^5.4.0",
    "redis": "^4.7.0",
    "typescript": "^5.7.0"
  }
}
